---
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = 'Gestão de Equipe' } = Astro.props;
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} />
</head>
<body>
  <slot />
</body>
</html>

