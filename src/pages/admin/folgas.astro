---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Folgas & Férias" active="folgas">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;flex-wrap:wrap;gap:.5rem">
    <div style="display:flex;gap:.5rem">
      <button class="btn btn-ghost btn-sm filter-btn active" data-tipo="">Todos</button>
      <button class="btn btn-ghost btn-sm filter-btn" data-tipo="folga">Folgas</button>
      <button class="btn btn-ghost btn-sm filter-btn" data-tipo="ferias">Férias</button>
      <button class="btn btn-ghost btn-sm filter-btn" data-tipo="horario">Horários</button>
    </div>
    <button class="btn btn-primary" id="btn-novo">+ Agendar</button>
  </div>

  <div class="card">
    <div class="card-body">
      <div class="table-wrap">
        <table class="table-cards">
          <thead>
            <tr>
              <th>Funcionário</th>
              <th>Tipo</th>
              <th>Início</th>
              <th>Fim</th>
              <th>Observação</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody id="tbody">
            <tr><td colspan="6"><div class="loading"><div class="spinner"></div> Carregando...</div></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="modal-backdrop" id="modal" style="display:none">
    <div class="modal">
      <div class="modal-header">
        <span class="modal-title" id="modal-title">Agendar</span>
        <button class="modal-close" id="modal-close">✕</button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">Funcionário *</label>
          <select class="form-control" id="funcionario_id" required>
            <option value="">Selecione...</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Tipo *</label>
          <select class="form-control" id="tipo">
            <option value="folga">Folga</option>
            <option value="ferias">Férias</option>
            <option value="horario">Mudança de Horário</option>
          </select>
        </div>

        <!-- Modo Folga / Horário: calendário de múltipla seleção -->
        <div id="modo-folga">
          <div class="form-group" style="margin-bottom:0">
            <label class="form-label" id="cal-label-tipo">Dias *</label>
            <div class="fc-nav">
              <button type="button" class="btn btn-ghost btn-sm" id="cal-prev">‹</button>
              <span id="cal-label" style="font-weight:600;min-width:10rem;text-align:center;font-size:.9rem"></span>
              <button type="button" class="btn btn-ghost btn-sm" id="cal-next">›</button>
            </div>
            <div class="fc-grid" id="fc-grid"></div>
            <div id="dias-info" class="fc-info">Nenhum dia selecionado</div>
          </div>
          <!-- Campo observação (aparece só quando tipo = horario) -->
          <div class="form-group" id="observacao-wrap" style="display:none;margin-top:var(--sp-3)">
            <label class="form-label">Horário / Observação *</label>
            <input class="form-control" type="text" id="observacao" placeholder="Ex: 11h CX, saiu cedo, 8h–14h" maxlength="100" />
          </div>
        </div>

        <!-- Modo Férias: intervalo de datas -->
        <div id="modo-ferias" style="display:none">
          <div class="grid-2">
            <div class="form-group">
              <label class="form-label">Data Início *</label>
              <input class="form-control" type="date" id="data_inicio" />
            </div>
            <div class="form-group">
              <label class="form-label">Data Fim *</label>
              <input class="form-control" type="date" id="data_fim" />
            </div>
          </div>
        </div>

        <div id="form-error" class="alert alert-danger" style="display:none;margin-top:var(--sp-3);margin-bottom:0"></div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-ghost" id="btn-cancel">Cancelar</button>
        <button class="btn btn-primary" id="btn-save">Salvar</button>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { supabase } from '../../lib/supabase';

  const MESES = ['','Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
  const DIAS_SEMANA = ['D','S','T','Q','Q','S','S'];

  let editingId: string | null = null;
  let currentFilter = '';

  // Estado do calendário
  let calMes = new Date().getMonth() + 1;
  let calAno = new Date().getFullYear();
  let diasSelecionados = new Set<string>(); // 'YYYY-MM-DD'
  let modoEdicaoUnico = false;

  // ===== CALENDÁRIO =====
  function isoDate(ano: number, mes: number, dia: number) {
    return `${ano}-${String(mes).padStart(2,'0')}-${String(dia).padStart(2,'0')}`;
  }

  function renderCalendario() {
    const grid = document.getElementById('fc-grid')!;
    const label = document.getElementById('cal-label')!;

    label.textContent = `${MESES[calMes]} ${calAno}`;

    const diasNoMes = new Date(calAno, calMes, 0).getDate();
    const primeiroDia = new Date(calAno, calMes - 1, 1).getDay();
    const hoje = new Date();
    const isHoje = (d: number) =>
      hoje.getDate() === d && hoje.getMonth() + 1 === calMes && hoje.getFullYear() === calAno;

    const cabecalho = DIAS_SEMANA.map(d => `<div class="fc-dow">${d}</div>`).join('');
    const vazias = Array.from({ length: primeiroDia }, () => '<div class="fc-day vazia"></div>').join('');
    const celulas = Array.from({ length: diasNoMes }, (_, i) => {
      const dia = i + 1;
      const iso = isoDate(calAno, calMes, dia);
      const sel = diasSelecionados.has(iso);
      const classes = ['fc-day', sel ? 'selected' : '', isHoje(dia) ? 'hoje' : ''].filter(Boolean).join(' ');
      return `<div class="${classes}" data-iso="${iso}">${dia}</div>`;
    }).join('');

    grid.innerHTML = cabecalho + vazias + celulas;

    grid.querySelectorAll<HTMLElement>('.fc-day:not(.vazia)').forEach(cell => {
      cell.addEventListener('click', () => {
        const iso = cell.dataset.iso!;
        if (modoEdicaoUnico) {
          diasSelecionados.clear();
          grid.querySelectorAll('.fc-day.selected').forEach(c => c.classList.remove('selected'));
          diasSelecionados.add(iso);
          cell.classList.add('selected');
        } else {
          if (diasSelecionados.has(iso)) {
            diasSelecionados.delete(iso);
            cell.classList.remove('selected');
          } else {
            diasSelecionados.add(iso);
            cell.classList.add('selected');
          }
        }
        atualizarInfo();
      });
    });

    atualizarInfo();
  }

  function atualizarInfo() {
    const info = document.getElementById('dias-info')!;
    const n = diasSelecionados.size;
    if (n === 0) {
      info.textContent = 'Nenhum dia selecionado';
      info.style.color = 'var(--text-muted)';
    } else {
      info.textContent = `${n} dia${n > 1 ? 's' : ''} selecionado${n > 1 ? 's' : ''}`;
      info.style.color = 'var(--accent)';
    }
  }

  document.getElementById('cal-prev')?.addEventListener('click', () => {
    calMes--; if (calMes < 1) { calMes = 12; calAno--; }
    renderCalendario();
  });
  document.getElementById('cal-next')?.addEventListener('click', () => {
    calMes++; if (calMes > 12) { calMes = 1; calAno++; }
    renderCalendario();
  });

  // ===== ALTERNAR MODO =====
  function setModo(tipo: string) {
    const mf = document.getElementById('modo-folga')!;
    const mv = document.getElementById('modo-ferias')!;
    const obsWrap = document.getElementById('observacao-wrap')!;
    const calLabelTipo = document.getElementById('cal-label-tipo')!;

    if (tipo === 'ferias') {
      mf.style.display = 'none';
      mv.style.display = '';
      obsWrap.style.display = 'none';
    } else {
      mf.style.display = '';
      mv.style.display = 'none';
      const isHorario = tipo === 'horario';
      obsWrap.style.display = isHorario ? '' : 'none';
      calLabelTipo.textContent = isHorario ? 'Dias com mudança de horário *' : 'Dias de Folga *';
    }
  }

  document.getElementById('tipo')?.addEventListener('change', (e) => {
    setModo((e.target as HTMLSelectElement).value);
  });

  // ===== LISTA =====
  async function load() {
    let query = supabase
      .from('folgas')
      .select('*, funcionarios(nome)')
      .order('data_inicio', { ascending: false });
    if (currentFilter) query = query.eq('tipo', currentFilter);
    const { data } = await query;

    const tbody = document.getElementById('tbody')!;
    if (!data || data.length === 0) {
      tbody.innerHTML = '<tr><td colspan="6"><div class="empty"><div class="empty-icon">📅</div>Nenhum registro encontrado</div></td></tr>';
      return;
    }
    tbody.innerHTML = data.map((f: any) => {
      const inicio = new Date(f.data_inicio + 'T00:00:00');
      const fim = new Date(f.data_fim + 'T00:00:00');
      const dias = Math.round((fim.getTime() - inicio.getTime()) / 86400000) + 1;
      const { badge, label } = tipoMeta(f.tipo);
      const obs = f.observacao ? escapeHtml(f.observacao) : '—';
      return `<tr>
        <td data-label="Funcionário"><strong>${escapeHtml(f.funcionarios?.nome ?? '—')}</strong></td>
        <td data-label="Tipo"><span class="badge ${badge}">${label}</span></td>
        <td data-label="Início">${formatDate(f.data_inicio)}</td>
        <td data-label="Fim">${formatDate(f.data_fim)}</td>
        <td data-label="Observação" style="font-size:.85rem;color:var(--text-muted)">${obs}</td>
        <td data-label="Ações" class="cell-actions">
          <button class="btn btn-ghost btn-sm btn-icon" onclick="openEdit('${f.id}')" aria-label="Editar">✏️</button>
          <button class="btn btn-danger btn-sm btn-icon" onclick="deleteFolga('${f.id}')" aria-label="Excluir">🗑️</button>
        </td>
      </tr>`;
    }).join('');
  }

  function tipoMeta(tipo: string) {
    if (tipo === 'ferias') return { badge: 'badge-info', label: '🏖️ Férias' };
    if (tipo === 'horario') return { badge: 'badge-horario', label: '🕐 Horário' };
    return { badge: 'badge-warning', label: '📋 Folga' };
  }

  function escapeHtml(s: string) {
    return String(s ?? '').replace(/[&<>"']/g, c =>
      ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]!));
  }

  function formatDate(d: string) {
    const [y, m, day] = d.split('-');
    return `${day}/${m}/${y}`;
  }

  async function loadFuncionarios() {
    const { data } = await supabase.from('funcionarios').select('id, nome').eq('ativo', true).order('nome');
    const sel = document.getElementById('funcionario_id') as HTMLSelectElement;
    (data ?? []).forEach((f: any) => {
      const opt = document.createElement('option');
      opt.value = f.id; opt.textContent = f.nome;
      sel.appendChild(opt);
    });
  }

  // ===== MODAL =====
  function openModal() { document.getElementById('modal')!.style.display = 'flex'; }

  function closeModal() {
    document.getElementById('modal')!.style.display = 'none';
    (document.getElementById('form-error') as HTMLElement).style.display = 'none';
    (document.getElementById('observacao') as HTMLInputElement).value = '';
    diasSelecionados.clear();
    editingId = null;
    modoEdicaoUnico = false;
  }

  function resetParaNovo() {
    const now = new Date();
    calMes = now.getMonth() + 1;
    calAno = now.getFullYear();
    diasSelecionados.clear();
    modoEdicaoUnico = false;
    editingId = null;
    document.getElementById('modal-title')!.textContent = 'Agendar';
    (document.getElementById('funcionario_id') as HTMLSelectElement).value = '';
    (document.getElementById('tipo') as HTMLSelectElement).value = 'folga';
    (document.getElementById('data_inicio') as HTMLInputElement).value = '';
    (document.getElementById('data_fim') as HTMLInputElement).value = '';
    (document.getElementById('observacao') as HTMLInputElement).value = '';
    setModo('folga');
    renderCalendario();
  }

  document.getElementById('btn-novo')?.addEventListener('click', () => {
    resetParaNovo();
    openModal();
  });
  document.getElementById('modal-close')?.addEventListener('click', closeModal);
  document.getElementById('btn-cancel')?.addEventListener('click', closeModal);

  (window as any).openEdit = async (id: string) => {
    const { data } = await supabase.from('folgas').select('*').eq('id', id).single();
    if (!data) return;
    editingId = id;
    document.getElementById('modal-title')!.textContent = 'Editar';
    (document.getElementById('funcionario_id') as HTMLSelectElement).value = data.funcionario_id;
    (document.getElementById('tipo') as HTMLSelectElement).value = data.tipo;
    (document.getElementById('observacao') as HTMLInputElement).value = data.observacao ?? '';
    setModo(data.tipo);

    if (data.tipo === 'folga' || data.tipo === 'horario') {
      modoEdicaoUnico = true;
      diasSelecionados.clear();
      diasSelecionados.add(data.data_inicio);
      const [y, m] = data.data_inicio.split('-').map(Number);
      calAno = y; calMes = m;
      renderCalendario();
    } else {
      modoEdicaoUnico = false;
      (document.getElementById('data_inicio') as HTMLInputElement).value = data.data_inicio;
      (document.getElementById('data_fim') as HTMLInputElement).value = data.data_fim;
    }
    openModal();
  };

  (window as any).deleteFolga = async (id: string) => {
    if (!confirm('Excluir este registro?')) return;
    const { error } = await supabase.from('folgas').delete().eq('id', id);
    if (error) { alert('Erro ao excluir: ' + error.message); return; }
    load();
  };

  // ===== SALVAR =====
  document.getElementById('btn-save')?.addEventListener('click', async () => {
    const funcionario_id = (document.getElementById('funcionario_id') as HTMLSelectElement).value;
    const tipo = (document.getElementById('tipo') as HTMLSelectElement).value;
    const observacao = (document.getElementById('observacao') as HTMLInputElement).value.trim() || null;
    const errorDiv = document.getElementById('form-error')!;

    if (!funcionario_id) {
      errorDiv.textContent = 'Selecione um funcionário.';
      errorDiv.style.display = 'block'; return;
    }

    if (tipo === 'folga' || tipo === 'horario') {
      if (diasSelecionados.size === 0) {
        errorDiv.textContent = 'Selecione pelo menos um dia.';
        errorDiv.style.display = 'block'; return;
      }
      if (tipo === 'horario' && !observacao) {
        errorDiv.textContent = 'Preencha o campo de horário/observação.';
        errorDiv.style.display = 'block'; return;
      }
      errorDiv.style.display = 'none';

      const dias = Array.from(diasSelecionados).sort();

      if (editingId) {
        const dia = dias[0];
        const { error } = await supabase.from('folgas')
          .update({ funcionario_id, tipo, data_inicio: dia, data_fim: dia, observacao })
          .eq('id', editingId);
        if (error) { errorDiv.textContent = 'Erro ao salvar: ' + error.message; errorDiv.style.display = 'block'; return; }
      } else {
        const registros = dias.map(d => ({ funcionario_id, tipo, data_inicio: d, data_fim: d, observacao }));
        const { error } = await supabase.from('folgas').insert(registros);
        if (error) { errorDiv.textContent = 'Erro ao salvar: ' + error.message; errorDiv.style.display = 'block'; return; }
      }
    } else {
      // Férias
      const data_inicio = (document.getElementById('data_inicio') as HTMLInputElement).value;
      const data_fim = (document.getElementById('data_fim') as HTMLInputElement).value;
      if (!data_inicio || !data_fim) {
        errorDiv.textContent = 'Preencha as datas de início e fim.';
        errorDiv.style.display = 'block'; return;
      }
      if (data_fim < data_inicio) {
        errorDiv.textContent = 'Data fim deve ser igual ou após a data início.';
        errorDiv.style.display = 'block'; return;
      }
      errorDiv.style.display = 'none';
      const { error } = editingId
        ? await supabase.from('folgas').update({ funcionario_id, tipo, data_inicio, data_fim, observacao: null }).eq('id', editingId)
        : await supabase.from('folgas').insert({ funcionario_id, tipo, data_inicio, data_fim });
      if (error) { errorDiv.textContent = 'Erro ao salvar: ' + error.message; errorDiv.style.display = 'block'; return; }
    }

    closeModal(); load();
  });

  // ===== FILTROS =====
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentFilter = (btn as HTMLElement).dataset.tipo ?? '';
      load();
    });
  });

  loadFuncionarios();
  load();
  renderCalendario();
</script>

<style>
  .filter-btn.active { background: var(--accent); color: #fff; border-color: var(--accent); }

  .badge-horario {
    background: #fff7ed;
    color: #c2410c;
    border: 1px solid #fed7aa;
  }

  /* Navegação do calendário */
  .fc-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--sp-2);
  }

  /* Grade do calendário */
  .fc-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 3px;
    margin-bottom: var(--sp-2);
  }

  .fc-dow {
    text-align: center;
    font-size: .68rem;
    font-weight: 700;
    color: var(--text-muted);
    padding: 2px 0 4px;
    text-transform: uppercase;
    letter-spacing: .03em;
  }

  .fc-day {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: .82rem;
    border-radius: 50%;
    cursor: pointer;
    border: 2px solid transparent;
    transition: background .1s, color .1s;
    user-select: none;
  }
  .fc-day:hover:not(.vazia) { background: var(--slate-100); }
  .fc-day.selected { background: var(--accent); color: #fff; font-weight: 600; }
  .fc-day.selected:hover { background: var(--accent); opacity: .85; }
  .fc-day.hoje { border-color: var(--accent); }
  .fc-day.hoje.selected { border-color: transparent; }
  .fc-day.vazia { cursor: default; }

  .fc-info {
    font-size: .8rem;
    font-weight: 500;
    color: var(--text-muted);
    min-height: 1.2rem;
  }
</style>
