---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Metas" active="metas">
  <div class="card" style="margin-bottom:1rem">
    <div class="card-body" style="display:flex;gap:1rem;align-items:flex-end;flex-wrap:wrap">
      <div class="form-group" style="margin:0;flex:1;min-width:140px">
        <label class="form-label">Mês</label>
        <select class="form-control" id="sel-mes">
          <option value="1">Janeiro</option><option value="2">Fevereiro</option>
          <option value="3">Março</option><option value="4">Abril</option>
          <option value="5">Maio</option><option value="6">Junho</option>
          <option value="7">Julho</option><option value="8">Agosto</option>
          <option value="9">Setembro</option><option value="10">Outubro</option>
          <option value="11">Novembro</option><option value="12">Dezembro</option>
        </select>
      </div>
      <div class="form-group" style="margin:0;flex:1;min-width:100px">
        <label class="form-label">Ano</label>
        <input class="form-control" type="number" id="sel-ano" value={new Date().getFullYear()} min="2020" max="2100" />
      </div>
      <button class="btn btn-primary" id="btn-novo">+ Lançar Meta</button>
    </div>
  </div>

  <div class="card">
    <div class="card-body" style="padding-bottom:0">
      <div class="table-wrap">
        <table class="table-cards">
          <thead>
            <tr>
              <th>Funcionário</th>
              <th>Meta (R$)</th>
              <th>Realizado (R$)</th>
              <th>%</th>
              <th>Status</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody id="tbody">
            <tr><td colspan="6"><div class="loading"><div class="spinner"></div> Carregando...</div></td></tr>
          </tbody>
        </table>
      </div>
    </div>
    <div id="resumo-metas" style="display:none;border-top:2px solid var(--border);padding:var(--sp-3) var(--sp-4) var(--sp-4)">
      <!-- populado pelo JS -->
    </div>
  </div>

  <div class="modal-backdrop" id="modal" style="display:none">
    <div class="modal">
      <div class="modal-header">
        <span class="modal-title" id="modal-title">Lançar Meta</span>
        <button class="modal-close" id="modal-close">✕</button>
      </div>
      <div class="modal-body">
        <form id="form">
          <input type="hidden" id="meta-id" />
          <div class="form-group">
            <label class="form-label">Funcionário *</label>
            <select class="form-control" id="funcionario_id" required>
              <option value="">Selecione...</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Valor da Meta (R$) *</label>
            <input class="form-control" type="number" id="valor_meta" min="0" step="0.01" required placeholder="0,00" />
          </div>
          <div id="meta-dica" style="display:none;font-size:.8rem;border-radius:var(--radius-sm);padding:var(--sp-2) var(--sp-3);margin-bottom:var(--sp-3)"></div>
          <p style="font-size:.8rem;color:#64748b;margin-bottom:1rem">
            O valor realizado é lançado na tela de <strong>Vendas</strong>.
          </p>
          <div id="form-error" class="alert alert-danger" style="display:none"></div>
        </form>
      </div>
      <div class="modal-footer">
        <button class="btn btn-ghost" id="btn-cancel">Cancelar</button>
        <button class="btn btn-primary" id="btn-save">Salvar</button>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { supabase } from '../../lib/supabase';

  let editingId: string | null = null;
  let metaLoja = 0;
  let metasFuncionarios: Array<{ meta_id: string; valor_meta: number }> = [];

  const selMes = document.getElementById('sel-mes') as HTMLSelectElement;
  const selAno = document.getElementById('sel-ano') as HTMLInputElement;
  selMes.value = String(new Date().getMonth() + 1);

  function fmtBRL(v: number) {
    return `R$ ${v.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}`;
  }

  async function load() {
    const mes = parseInt(selMes.value);
    const ano = parseInt(selAno.value);

    const [desempRes, lojaRes] = await Promise.all([
      supabase.from('desempenho_mensal').select('*').eq('mes', mes).eq('ano', ano).not('meta_id', 'is', null).order('valor_meta', { ascending: false }),
      supabase.from('metas_loja').select('valor_meta').eq('mes', mes).eq('ano', ano).maybeSingle(),
    ]);

    metaLoja = Number(lojaRes.data?.valor_meta ?? 0);

    const tbody = document.getElementById('tbody')!;
    const resumo = document.getElementById('resumo-metas')!;

    if (desempRes.error) {
      tbody.innerHTML = `<tr><td colspan="6"><div class="alert alert-danger">Erro ao carregar metas: ${desempRes.error.message}</div></td></tr>`;
      resumo.style.display = 'none';
      return;
    }

    const data = desempRes.data ?? [];
    metasFuncionarios = data.map((m: any) => ({ meta_id: m.meta_id, valor_meta: Number(m.valor_meta) }));

    if (data.length === 0) {
      tbody.innerHTML = '<tr><td colspan="6"><div class="empty"><div class="empty-icon">🎯</div>Nenhuma meta lançada para este período</div></td></tr>';
    } else {
      tbody.innerHTML = data.map((m: any) => {
        const pct = Number(m.percentual ?? 0);
        const cls   = pct >= 100 ? 'success' : pct >= 70 ? 'warning' : 'danger';
        const badge = pct >= 100 ? 'badge-success' : pct >= 70 ? 'badge-warning' : 'badge-danger';
        const lbl   = pct >= 100 ? 'Atingida' : pct >= 70 ? 'Em progresso' : 'Abaixo';
        return `<tr>
          <td data-label="Funcionário"><strong>${m.nome ?? '—'}</strong></td>
          <td data-label="Meta">${fmtBRL(Number(m.valor_meta))}</td>
          <td data-label="Realizado">${fmtBRL(Number(m.valor_realizado))}</td>
          <td data-label="Atingimento">
            <div style="min-width:80px;width:100%;max-width:12rem">
              <div style="font-weight:600;margin-bottom:4px">${pct}%</div>
              <div class="progress"><div class="progress-bar ${cls}" style="width:${Math.min(pct,100)}%"></div></div>
            </div>
          </td>
          <td data-label="Status"><span class="badge ${badge}">${lbl}</span></td>
          <td data-label="Ações" class="cell-actions">
            <button class="btn btn-ghost btn-sm btn-icon" onclick="openEdit('${m.meta_id}')" aria-label="Editar">✏️</button>
            <button class="btn btn-danger btn-sm btn-icon" onclick="deleteMeta('${m.meta_id}')" aria-label="Excluir">🗑️</button>
          </td>
        </tr>`;
      }).join('');
    }

    // Rodapé com totais
    const totalFunc = metasFuncionarios.reduce((s, m) => s + m.valor_meta, 0);
    const saldo = metaLoja - totalFunc;

    let resumoHtml = `
      <div class="metas-resumo">
        <div class="metas-resumo-row">
          <span class="metas-resumo-label">Total distribuído (funcionários)</span>
          <span class="metas-resumo-val">${fmtBRL(totalFunc)}</span>
        </div>`;

    if (metaLoja > 0) {
      const saldoCor = saldo >= 0 ? 'var(--success)' : 'var(--danger)';
      const saldoIcon = saldo >= 0 ? '✅' : '⚠️';
      resumoHtml += `
        <div class="metas-resumo-row">
          <span class="metas-resumo-label">Meta da loja (${mes.toString().padStart(2,'0')}/${ano})</span>
          <span class="metas-resumo-val">${fmtBRL(metaLoja)}</span>
        </div>
        <div class="metas-resumo-row" style="border-top:1px solid var(--border);padding-top:var(--sp-2);margin-top:var(--sp-1)">
          <span class="metas-resumo-label" style="font-weight:700">Saldo não distribuído ${saldoIcon}</span>
          <span class="metas-resumo-val" style="font-weight:700;color:${saldoCor}">${saldo >= 0 ? '' : '−'}${fmtBRL(Math.abs(saldo))}</span>
        </div>`;
    } else {
      resumoHtml += `
        <div class="metas-resumo-row" style="color:var(--text-muted);font-size:.8rem;font-style:italic">
          <span>Meta da loja não definida para este período — configure em <strong>Vendas → Meta da Loja</strong></span>
        </div>`;
    }

    resumoHtml += '</div>';
    resumo.innerHTML = resumoHtml;
    resumo.style.display = 'block';
  }

  function atualizarDica() {
    const dicaEl = document.getElementById('meta-dica')!;
    const valorDigitado = parseFloat((document.getElementById('valor_meta') as HTMLInputElement).value) || 0;
    const somaOutros = metasFuncionarios
      .filter(m => m.meta_id !== editingId)
      .reduce((s, m) => s + m.valor_meta, 0);

    if (metaLoja === 0) {
      dicaEl.textContent = 'Meta da loja não definida — não há limite a verificar.';
      dicaEl.style.cssText = 'display:block;background:var(--slate-100);color:var(--text-muted)';
      return;
    }

    const saldoAposEsse = metaLoja - somaOutros - valorDigitado;
    const saldoCor  = saldoAposEsse >= 0 ? 'var(--success)' : 'var(--danger)';
    const bgCor     = saldoAposEsse >= 0 ? 'rgba(34,197,94,.08)' : 'rgba(239,68,68,.08)';
    const icon      = saldoAposEsse >= 0 ? '✅' : '⚠️';

    dicaEl.innerHTML = `
      <div style="display:grid;gap:2px">
        <div style="display:flex;justify-content:space-between"><span>Meta da loja:</span><strong>${fmtBRL(metaLoja)}</strong></div>
        <div style="display:flex;justify-content:space-between"><span>Outras metas:</span><span>${fmtBRL(somaOutros)}</span></div>
        <div style="display:flex;justify-content:space-between;margin-top:4px;font-weight:700;color:${saldoCor}">
          <span>Saldo após este ${icon}</span>
          <span>${saldoAposEsse >= 0 ? '' : '−'}${fmtBRL(Math.abs(saldoAposEsse))}</span>
        </div>
      </div>`;
    dicaEl.style.cssText = `display:block;background:${bgCor};color:var(--slate-700)`;
  }

  async function loadFuncionarios() {
    const { data } = await supabase.from('funcionarios').select('id, nome').eq('ativo', true).order('nome');
    const sel = document.getElementById('funcionario_id') as HTMLSelectElement;
    (data ?? []).forEach((f: any) => {
      const opt = document.createElement('option');
      opt.value = f.id; opt.textContent = f.nome;
      sel.appendChild(opt);
    });
  }

  function openModal() { document.getElementById('modal')!.style.display = 'flex'; }
  function closeModal() {
    document.getElementById('modal')!.style.display = 'none';
    (document.getElementById('form') as HTMLFormElement).reset();
    document.getElementById('form-error')!.style.display = 'none';
    editingId = null;
  }

  function mostrarErro(msg: string) {
    const el = document.getElementById('form-error')!;
    el.textContent = msg;
    el.style.display = 'block';
  }

  document.getElementById('valor_meta')?.addEventListener('input', atualizarDica);

  document.getElementById('btn-novo')?.addEventListener('click', () => {
    document.getElementById('modal-title')!.textContent = 'Lançar Meta';
    editingId = null;
    openModal();
    atualizarDica();
  });
  document.getElementById('modal-close')?.addEventListener('click', closeModal);
  document.getElementById('btn-cancel')?.addEventListener('click', closeModal);
  selMes.addEventListener('change', load);
  selAno.addEventListener('change', load);

  (window as any).openEdit = async (id: string) => {
    const { data } = await supabase.from('metas').select('*').eq('id', id).single();
    if (!data) return;
    editingId = id;
    document.getElementById('modal-title')!.textContent = 'Editar Meta';
    (document.getElementById('funcionario_id') as HTMLSelectElement).value = data.funcionario_id;
    (document.getElementById('valor_meta') as HTMLInputElement).value = data.valor_meta;
    openModal();
    atualizarDica();
  };

  (window as any).deleteMeta = async (id: string) => {
    if (!confirm('Excluir esta meta?')) return;
    const { error } = await supabase.from('metas').delete().eq('id', id);
    if (error) { alert('Erro ao excluir a meta: ' + error.message); return; }
    load();
  };

  document.getElementById('btn-save')?.addEventListener('click', async () => {
    const funcionario_id = (document.getElementById('funcionario_id') as HTMLSelectElement).value;
    const valor_meta = parseFloat((document.getElementById('valor_meta') as HTMLInputElement).value);
    const mes = parseInt(selMes.value);
    const ano = parseInt(selAno.value);

    if (!funcionario_id || isNaN(valor_meta)) {
      mostrarErro('Preencha todos os campos obrigatórios.');
      return;
    }
    document.getElementById('form-error')!.style.display = 'none';

    const { error } = editingId
      ? await supabase.from('metas').update({ funcionario_id, valor_meta, mes, ano }).eq('id', editingId)
      : await supabase.from('metas').insert({ funcionario_id, valor_meta, mes, ano });

    if (error) {
      // 23505 = violação de UNIQUE(funcionario_id, mes, ano)
      mostrarErro(error.code === '23505'
        ? 'Este funcionário já tem uma meta lançada para este mês. Edite a meta existente.'
        : 'Erro ao salvar a meta: ' + error.message);
      return;
    }
    closeModal(); load();
  });

  loadFuncionarios(); load();
</script>

