---
import '../styles/global.css';
const base = import.meta.env.BASE_URL;
const MESES = ['','Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
const now = new Date();
const mesAtual = now.getMonth() + 1;
const anoAtual = now.getFullYear();
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard — Gestão de Equipe</title>
  <link rel="icon" href={`${base}favicon.svg`} />
</head>
<body>

<header class="top-bar">
  <div class="top-bar-inner">
    <div class="brand">
      <span class="brand-icon">💊</span>
      <div class="brand-text">
        <div class="brand-title">Gestão de Equipe</div>
        <div class="brand-sub">Painel da equipe</div>
      </div>
    </div>
    <div style="display:flex;gap:var(--sp-2);align-items:center">
      <button class="btn btn-sm export-btn" id="btn-export-pdf" title="Exportar dashboard como PDF">📄 <span>PDF</span></button>
      <a href={`${base}admin/`} class="btn btn-sm admin-link">⚙️ <span>Admin</span></a>
    </div>
  </div>
  <div class="top-bar-period">
    <label class="period-label" for="sel-mes">Período</label>
    <div class="period-controls">
      <select id="sel-mes" class="form-control">
        {MESES.slice(1).map((m, i) => (
          <option value={i + 1} selected={i + 1 === mesAtual}>{m}</option>
        ))}
      </select>
      <input type="number" id="sel-ano" class="form-control" value={anoAtual}
        min="2020" max="2100" aria-label="Ano" />
    </div>
  </div>
</header>

<!-- Cabeçalho apenas visível na impressão/PDF -->
<div class="print-header" id="print-header">
  <div>
    <div class="print-header-title">💊 Gestão de Equipe — Dashboard</div>
  </div>
  <div id="print-periodo-label" class="print-header-periodo"></div>
</div>

<main class="dashboard">

  <!-- Avisos ativos -->
  <section class="section" id="avisos-section" hidden>
    <div id="avisos-list" class="avisos-list"></div>
  </section>

  <!-- Stats Row -->
  <section class="grid-4 section" id="stats-row">
    <div class="stat-card" id="stat-vendas-loja">
      <div class="stat-label">Vendas da Loja</div>
      <div class="stat-value loading-val">—</div>
      <div class="loja-progresso" hidden>
        <div class="progress"><div class="progress-bar" id="loja-barra" style="width:0%"></div></div>
      </div>
      <div class="stat-sub" id="loja-sub">este mês</div>
    </div>
    <div class="stat-card" id="stat-total-metas">
      <div class="stat-label">Funcionários com Meta</div>
      <div class="stat-value loading-val">—</div>
      <div class="stat-sub">lançadas este mês</div>
    </div>
    <div class="stat-card" id="stat-media-metas">
      <div class="stat-label">Atingimento Médio</div>
      <div class="stat-value loading-val">—</div>
      <div class="stat-sub">de metas este mês</div>
    </div>
    <div class="stat-card" id="stat-folgas">
      <div class="stat-label">Folgas/Férias</div>
      <div class="stat-value loading-val">—</div>
      <div class="stat-sub">agendadas este mês</div>
    </div>
  </section>

  <!-- Ritmo de Vendas (só aparece quando há meta da loja definida) -->
  <section id="ritmo-section" class="card section" hidden>
    <div class="card-header">
      <span class="card-title">📈 Ritmo de Vendas</span>
      <span id="ritmo-status" class="badge"></span>
    </div>
    <div class="card-body" id="ritmo-body"></div>
  </section>

  <!-- Entregas por Mês -->
  <section id="entregas-section" class="card section" hidden>
    <div class="card-header">
      <span class="card-title">📦 Entregas por Mês</span>
    </div>
    <div class="card-body" id="entregas-body"></div>
  </section>

  <!-- Calendário de Folgas — largura total, uma posição acima das metas -->
  <div class="card section">
    <div class="card-header">
      <span class="card-title">📅 Folgas & Férias</span>
      <div style="display:flex;gap:.5rem;flex-wrap:wrap">
        <button class="btn btn-ghost btn-sm filter-tipo active" data-tipo="">Todos</button>
        <button class="btn btn-ghost btn-sm filter-tipo" data-tipo="folga">Folgas</button>
        <button class="btn btn-ghost btn-sm filter-tipo" data-tipo="ferias">Férias</button>
        <button class="btn btn-ghost btn-sm filter-tipo" data-tipo="horario">Horários</button>
      </div>
    </div>
    <div class="card-body" id="folgas-body">
      <div class="loading"><div class="spinner"></div> Carregando...</div>
    </div>
  </div>

  <div class="grid-2 section">
    <!-- Metas dos Funcionários -->
    <div class="card">
      <div class="card-header">
        <span class="card-title">🎯 Metas dos Funcionários</span>
        <span id="metas-periodo" style="font-size:.8rem;color:#64748b"></span>
      </div>
      <div class="card-body" id="metas-body">
        <div class="loading"><div class="spinner"></div> Carregando...</div>
      </div>
    </div>

    <!-- Coluna direita: Escalas + Aniversários -->
    <div style="display:flex;flex-direction:column;gap:var(--sp-5)">
      <!-- Escalas de Trabalho -->
      <div class="card" id="escalas-section" hidden>
        <div class="card-header">
          <span class="card-title">📋 Escalas de Trabalho</span>
        </div>
        <div class="card-body" id="escalas-body">
          <div class="loading"><div class="spinner"></div></div>
        </div>
      </div>

      <!-- Aniversários -->
      <div class="card">
        <div class="card-header">
          <span class="card-title">🎂 Aniversários do Mês</span>
          <span id="aniv-periodo" style="font-size:.8rem;color:var(--text-muted)"></span>
        </div>
        <div class="card-body" id="aniv-body">
          <div class="loading"><div class="spinner"></div> Carregando...</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Vendas por Funcionário -->
  <div class="card section">
    <div class="card-header">
      <span class="card-title">💰 Vendas por Funcionário</span>
      <span id="vendas-periodo" style="font-size:.8rem;color:#64748b"></span>
    </div>
    <div class="card-body" id="vendas-body">
      <div class="loading"><div class="spinner"></div> Carregando...</div>
    </div>
  </div>

  <!-- Top Produtos -->
  <section class="card section">
    <div class="card-header">
      <span class="card-title">💊 Top Produtos</span>
      <div class="prod-filtros">
        <input class="form-control" id="busca-prod" placeholder="🔍 Nome ou substância..." />
        <select class="form-control" id="prod-mes">
          <option value="">Todos os meses</option>
          {MESES.slice(1).map((m, i) => (
            <option value={i + 1}>{m}</option>
          ))}
        </select>
      </div>
    </div>
    <div class="card-body" id="produtos-body" style="padding:0">
      <div class="loading"><div class="spinner"></div> Carregando...</div>
    </div>
  </section>

  <!-- Histórico de avisos -->
  <section class="card section">
    <details id="hist-details">
      <summary class="hist-summary">
        <span class="card-title">🗂️ Histórico de avisos</span>
        <span class="hist-meta"><span id="hist-count">—</span> <span class="hist-chevron">▾</span></span>
      </summary>
      <div class="card-body" id="historico-body">
        <div class="loading"><div class="spinner"></div> Carregando...</div>
      </div>
    </details>
  </section>

  <!-- Reuniões -->
  <section class="card section" id="reunioes-section" hidden>
    <div class="card-header">
      <span class="card-title">🗓️ Reuniões</span>
    </div>
    <div class="card-body" id="reunioes-body">
      <div class="loading"><div class="spinner"></div> Carregando...</div>
    </div>
  </section>

</main>

<script>
  import { supabase } from '../lib/supabase';
  import { intervaloDoMes, formatarData } from '../lib/dates';
  import { renderMd } from '../lib/markdown';

  const MESES = ['','Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
  const MESES_SHORT = ['','Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];

  /* Os avisos são escritos por pessoas e vão para innerHTML — escapar
     é o que impede que um "<" no texto quebre ou injete marcação. */
  function escapeHtml(s: string) {
    return String(s).replace(/[&<>"']/g, c =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  }

  const TIPOS_AVISO: Record<string, { classe: string; icone: string; rotulo: string }> = {
    info:    { classe: 'aviso-info',    icone: 'ℹ️', rotulo: 'Informativo' },
    atencao: { classe: 'aviso-atencao', icone: '⚠️', rotulo: 'Atenção' },
    urgente: { classe: 'aviso-urgente', icone: '🚨', rotulo: 'Urgente' },
  };

  const selMes = document.getElementById('sel-mes') as HTMLSelectElement;
  const selAno = document.getElementById('sel-ano') as HTMLInputElement;

  function getMes() { return parseInt(selMes.value); }
  function getAno() { return parseInt(selAno.value); }

  // ===== RITMO DE VENDAS =====
  function gerarGraficoRitmo(diasNoMes: number, diaDecorrido: number, meta: number, realizado: number, projecao: number, cls: string) {
    const W = 400, H = 130;
    const pad = { t: 8, r: 12, b: 24, l: 52 };
    const aw = W - pad.l - pad.r;
    const ah = H - pad.t - pad.b;
    const yMax = Math.max(meta, projecao, 1) * 1.06;
    const xS = (d: number) => (pad.l + (d / diasNoMes) * aw).toFixed(1);
    const yS = (v: number) => (pad.t + ah - (v / yMax) * ah).toFixed(1);
    const clrMap: Record<string, string> = { success: 'var(--success)', warning: 'var(--warning)', danger: 'var(--danger)' };
    const clr = clrMap[cls] ?? 'var(--accent)';
    const fmtShort = (v: number) => v >= 1000 ? `${(v / 1000).toFixed(0)}k` : String(Math.round(v));

    const gridVals = [0, meta / 2, meta];
    const gridLines = gridVals.map(v => {
      const y = yS(v);
      return `<line x1="${pad.l}" y1="${y}" x2="${pad.l + aw}" y2="${y}" stroke="var(--slate-200)" stroke-width="1"/>`;
    }).join('');
    const yLabels = gridVals.map(v => {
      const y = (parseFloat(yS(v)) + 3.5).toFixed(1);
      return `<text x="${pad.l - 4}" y="${y}" text-anchor="end" font-size="9" fill="var(--text-muted)">R$${fmtShort(v)}</text>`;
    }).join('');

    const paceD = `M${xS(0)} ${yS(0)} L${xS(diasNoMes)} ${yS(meta)}`;
    const actualD = diaDecorrido > 0 ? `M${xS(0)} ${yS(0)} L${xS(diaDecorrido)} ${yS(realizado)}` : '';
    const projD = diaDecorrido > 0 && diaDecorrido < diasNoMes
      ? `M${xS(diaDecorrido)} ${yS(realizado)} L${xS(diasNoMes)} ${yS(projecao)}` : '';

    const todayLine = diaDecorrido > 0 && diaDecorrido < diasNoMes
      ? `<line x1="${xS(diaDecorrido)}" y1="${pad.t}" x2="${xS(diaDecorrido)}" y2="${pad.t + ah}" stroke="var(--slate-300)" stroke-width="1" stroke-dasharray="3,3"/>`
      : '';
    const dotActual = diaDecorrido > 0
      ? `<circle cx="${xS(diaDecorrido)}" cy="${yS(realizado)}" r="3.5" fill="${clr}"/>`
      : '';
    const dotProj = diaDecorrido > 0 && diaDecorrido < diasNoMes
      ? `<circle cx="${xS(diasNoMes)}" cy="${yS(projecao)}" r="3" fill="${clr}" fill-opacity=".4" stroke="${clr}" stroke-width="1.5"/>`
      : '';

    const xLbls = [1, Math.round(diasNoMes / 2), diasNoMes].map(d =>
      `<text x="${xS(d)}" y="${H - 4}" text-anchor="middle" font-size="9" fill="var(--text-muted)">${d}</text>`
    ).join('');

    return `<svg viewBox="0 0 ${W} ${H}" width="100%" style="display:block;overflow:visible">
      ${gridLines}${yLabels}${todayLine}
      <path d="${paceD}" fill="none" stroke="var(--slate-300)" stroke-width="1.5" stroke-dasharray="4,3"/>
      ${actualD ? `<path d="${actualD}" fill="none" stroke="${clr}" stroke-width="2.5"/>` : ''}
      ${projD ? `<path d="${projD}" fill="none" stroke="${clr}" stroke-width="1.5" stroke-dasharray="5,4" stroke-opacity=".75"/>` : ''}
      ${dotActual}${dotProj}${xLbls}
    </svg>`;
  }

  function renderRitmo(lojaData: any, mes: number, ano: number) {
    const section = document.getElementById('ritmo-section') as HTMLElement;
    if (!lojaData) { section.hidden = true; return; }
    const meta = Number(lojaData.valor_meta ?? 0);
    const realizado = Number(lojaData.valor_realizado ?? 0);
    if (meta <= 0) { section.hidden = true; return; }

    section.hidden = false;

    const diasNoMes = new Date(ano, mes, 0).getDate();
    const hoje = new Date();
    const ehMesAtual = hoje.getMonth() + 1 === mes && hoje.getFullYear() === ano;
    const ehMesFuturo = ano > hoje.getFullYear() || (ano === hoje.getFullYear() && mes > hoje.getMonth() + 1);

    const diaDecorrido = ehMesAtual ? hoje.getDate() : ehMesFuturo ? 0 : diasNoMes;
    const diasRestantes = ehMesAtual ? diasNoMes - hoje.getDate() : 0;

    const ritmoAtual = diaDecorrido > 0 ? realizado / diaDecorrido : 0;
    const projecao = ritmoAtual > 0 ? Math.round(ritmoAtual * diasNoMes) : realizado;
    const necessarioPorDia = diasRestantes > 0 ? Math.max(meta - realizado, 0) / diasRestantes : 0;

    const cls = projecao >= meta ? 'success' : projecao >= meta * 0.85 ? 'warning' : 'danger';
    const clsLabels: Record<string, string> = { success: 'No ritmo ✓', warning: 'Atenção ⚠️', danger: 'Abaixo do ritmo' };

    const statusBadge = document.getElementById('ritmo-status')!;
    statusBadge.textContent = clsLabels[cls];
    statusBadge.className = `badge badge-${cls}`;

    const fmt = (v: number) => `R$ ${Math.round(v).toLocaleString('pt-BR')}`;

    type KpiItem = { label: string; valor: string; sub: string; highlight: boolean };
    const kpis: KpiItem[] = [
      { label: 'Realizado', valor: fmt(realizado), sub: `de ${fmt(meta)} de meta`, highlight: false },
      {
        label: diasRestantes > 0 ? 'Necessário/dia' : 'Média/dia',
        valor: fmt(diasRestantes > 0 ? necessarioPorDia : ritmoAtual),
        sub: diasRestantes > 0 ? `para bater a meta em ${diasRestantes} dias` : 'ao longo do mês',
        highlight: false,
      },
      {
        label: 'Projeção final',
        valor: fmt(projecao),
        sub: projecao >= meta ? `acima da meta (${fmt(projecao - meta)})` : `falta ${fmt(meta - projecao)}`,
        highlight: true,
      },
    ];

    const body = document.getElementById('ritmo-body')!;
    body.innerHTML = `
      <div class="ritmo-chart">${gerarGraficoRitmo(diasNoMes, diaDecorrido, meta, realizado, projecao, cls)}</div>
      <div class="ritmo-kpis">
        ${kpis.map(k => {
          const style = k.highlight ? ` style="color:var(--${cls})"` : '';
          return `<div class="ritmo-kpi">
            <div class="ritmo-kpi-label">${k.label}</div>
            <div class="ritmo-kpi-valor"${style}>${k.valor}</div>
            <div class="ritmo-kpi-sub">${k.sub}</div>
          </div>`;
        }).join('')}
      </div>`;
  }

  // ===== ENTREGAS =====
  function getUltimosMeses(mes: number, ano: number, n: number = 6) {
    const lista: { mes: number; ano: number }[] = [];
    for (let i = n - 1; i >= 0; i--) {
      let m = mes - i;
      let a = ano;
      while (m <= 0) { m += 12; a--; }
      lista.push({ mes: m, ano: a });
    }
    return lista;
  }

  function gerarGraficoEntregas(dados: { mes: number; ano: number; quantidade: number }[], mesSel: number, anoSel: number) {
    const W = 400, H = 140;
    const pad = { t: 24, r: 12, b: 26, l: 12 };
    const aw = W - pad.l - pad.r;
    const ah = H - pad.t - pad.b;
    const n = dados.length;
    if (n === 0) return '';

    const maxVal = Math.max(...dados.map(d => d.quantidade), 1);
    const gap = 8;
    const barW = Math.floor((aw - (n - 1) * gap) / n);

    const bars = dados.map((d, i) => {
      const x = pad.l + i * (barW + gap);
      const isSel = d.mes === mesSel && d.ano === anoSel;
      const barH = d.quantidade > 0
        ? Math.max(Math.round((d.quantidade / maxVal) * ah), 4)
        : 2;
      const y = pad.t + ah - barH;
      const fill = isSel ? 'var(--accent)' : (d.quantidade > 0 ? 'var(--slate-200)' : 'var(--slate-100)');
      const textFill = isSel ? 'var(--accent)' : 'var(--text-muted)';
      const fw = isSel ? '700' : '400';
      const label = MESES_SHORT[d.mes];
      return [
        `<rect x="${x}" y="${y}" width="${barW}" height="${barH}" rx="3" fill="${fill}"/>`,
        d.quantidade > 0 ? `<text x="${x + barW / 2}" y="${y - 5}" text-anchor="middle" font-size="10" fill="${textFill}" font-weight="${fw}">${d.quantidade}</text>` : '',
        `<text x="${x + barW / 2}" y="${H - 6}" text-anchor="middle" font-size="9" fill="${textFill}" font-weight="${fw}">${label}</text>`,
      ].join('');
    }).join('');

    return `<svg viewBox="0 0 ${W} ${H}" width="100%" style="display:block">${bars}</svg>`;
  }

  async function loadEntregas() {
    const mes = getMes(); const ano = getAno();
    const section = document.getElementById('entregas-section') as HTMLElement;
    const body = document.getElementById('entregas-body')!;

    const periodos = getUltimosMeses(mes, ano, 6);

    const { data, error } = await supabase
      .from('entregas')
      .select('mes, ano, quantidade')
      .order('ano').order('mes');

    if (error) { section.hidden = true; return; }

    const dataMap = new Map<string, number>();
    (data ?? []).forEach((d: any) => dataMap.set(`${d.ano}-${d.mes}`, Number(d.quantidade)));

    const dados = periodos.map(p => ({
      mes: p.mes,
      ano: p.ano,
      quantidade: dataMap.get(`${p.ano}-${p.mes}`) ?? 0,
    }));

    if (dados.every(d => d.quantidade === 0)) { section.hidden = true; return; }
    section.hidden = false;

    const idx = dados.length - 1;
    const qtdAtual = dados[idx].quantidade;
    const prev = idx >= 1 ? dados[idx - 1] : null;
    const qtdPrev = prev?.quantidade ?? 0;

    const delta = prev !== null && qtdPrev > 0
      ? Math.round(((qtdAtual - qtdPrev) / qtdPrev) * 100)
      : null;

    const deltaHtml = delta !== null
      ? `<div class="entregas-delta" style="color:${delta >= 0 ? 'var(--success)' : 'var(--danger)'}">
           ${delta >= 0 ? '▲' : '▼'} ${Math.abs(delta)}% vs ${MESES_SHORT[prev!.mes]}
         </div>`
      : '';

    body.innerHTML = `
      <div class="entregas-wrap">
        <div class="entregas-stat">
          <div class="entregas-num">${qtdAtual.toLocaleString('pt-BR')}</div>
          <div class="entregas-label">em ${MESES_SHORT[mes]}/${ano}</div>
          ${deltaHtml}
        </div>
        <div class="entregas-chart">${gerarGraficoEntregas(dados, mes, ano)}</div>
      </div>`;
  }

  // ===== STATS =====
  async function loadStats() {
    const mes = getMes(); const ano = getAno();
    const { inicio, fim } = intervaloDoMes(mes, ano);
    const [lojaRes, desempenhoRes, folgasRes] = await Promise.all([
      supabase.from('desempenho_loja').select('*').eq('mes', mes).eq('ano', ano).maybeSingle(),
      supabase.from('desempenho_mensal').select('valor_meta, percentual').eq('mes', mes).eq('ano', ano),
      supabase.from('folgas').select('id', { count: 'exact', head: true })
        .lte('data_inicio', fim).gte('data_fim', inicio),
    ]);

    const totalLoja = Number(lojaRes.data?.valor_realizado ?? 0);
    const metaLoja = Number(lojaRes.data?.valor_meta ?? 0);
    document.getElementById('stat-vendas-loja')!.querySelector('.stat-value')!.textContent =
      `R$ ${totalLoja.toLocaleString('pt-BR', {minimumFractionDigits:2})}`;

    // A barra só aparece quando há meta definida — sem meta, não há
    // progresso a mostrar, e o card volta a ser só o valor do mês.
    const progressoEl = document.querySelector('.loja-progresso') as HTMLElement;
    const subEl = document.getElementById('loja-sub')!;
    if (metaLoja > 0) {
      const pctLoja = Number(lojaRes.data?.percentual ?? 0);
      const barra = document.getElementById('loja-barra') as HTMLElement;
      barra.style.width = `${Math.min(pctLoja, 100)}%`;
      barra.className = 'progress-bar ' + (pctLoja >= 100 ? 'success' : pctLoja >= 70 ? 'warning' : 'danger');
      progressoEl.hidden = false;
      subEl.textContent = `${pctLoja}% da meta de R$ ${metaLoja.toLocaleString('pt-BR', {minimumFractionDigits:2})}`;
    } else {
      progressoEl.hidden = true;
      subEl.textContent = 'este mês';
    }

    const linhas = desempenhoRes.data ?? [];
    const comMeta = linhas.filter((d: any) => Number(d.valor_meta) > 0);
    document.getElementById('stat-total-metas')!.querySelector('.stat-value')!.textContent = String(comMeta.length);

    // Só entra na média quem tem meta definida — quem vendeu sem meta
    // tem percentual NULL e não deve puxar o indicador para baixo.
    const comPercentual = linhas.filter((d: any) => d.percentual !== null);
    const media = comPercentual.length > 0
      ? Math.round(comPercentual.reduce((s: number, d: any) => s + Number(d.percentual), 0) / comPercentual.length)
      : 0;
    const mediaEl = document.getElementById('stat-media-metas')!.querySelector('.stat-value') as HTMLElement;
    const temMedia = comPercentual.length > 0;
    mediaEl.textContent = temMedia ? `${media}%` : '—';
    // Sem nenhuma meta lançada não há desempenho ruim a sinalizar — pintar
    // o traço de vermelho faria parecer alerta onde só falta informação.
    mediaEl.style.color = !temMedia
      ? 'var(--text-subtle)'
      : media >= 100 ? 'var(--success)' : media >= 70 ? 'var(--warning)' : 'var(--danger)';

    document.getElementById('stat-folgas')!.querySelector('.stat-value')!.textContent =
      String(folgasRes.count ?? 0);

    renderRitmo(lojaRes.data, mes, ano);
  }

  // ===== METAS =====
  async function loadMetas() {
    const mes = getMes(); const ano = getAno();
    document.getElementById('metas-periodo')!.textContent = `${MESES[mes]} ${ano}`;
    const { data } = await supabase
      .from('desempenho_mensal')
      .select('*')
      .eq('mes', mes).eq('ano', ano)
      .gt('valor_meta', 0)
      .order('valor_meta', { ascending: false });

    const body = document.getElementById('metas-body')!;
    if (!data || data.length === 0) {
      body.innerHTML = '<div class="empty"><div class="empty-icon">🎯</div>Nenhuma meta lançada para este período</div>';
      return;
    }
    const totalRealizado = data.reduce((s: number, m: any) => s + Number(m.valor_realizado ?? 0), 0);
    const totalMeta = data.reduce((s: number, m: any) => s + Number(m.valor_meta ?? 0), 0);
    const pctGeral = totalMeta > 0 ? Math.round((totalRealizado / totalMeta) * 100) : 0;
    const clsGeral = pctGeral >= 100 ? 'success' : pctGeral >= 70 ? 'warning' : 'danger';

    const linhasHtml = data.map((m: any) => {
      const pctReal = Number(m.percentual ?? 0);
      const pct = Math.min(pctReal, 100);
      const cls = pctReal >= 100 ? 'success' : pctReal >= 70 ? 'warning' : 'danger';
      const color = pctReal >= 100 ? 'var(--success)' : pctReal >= 70 ? 'var(--warning)' : 'var(--danger)';
      return `<div style="margin-bottom:1rem">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.35rem">
          <div>
            <span style="font-weight:600">${escapeHtml(m.nome ?? '—')}</span>
            ${m.cargo ? `<span style="font-size:.75rem;color:var(--text-muted);margin-left:.5rem">${escapeHtml(m.cargo)}</span>` : ''}
          </div>
          <span style="font-weight:700;color:${color}">${pctReal}%</span>
        </div>
        <div class="progress" style="margin-bottom:.3rem">
          <div class="progress-bar ${cls}" style="width:${pct}%"></div>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:.75rem;color:var(--text-muted)">
          <span>Realizado: R$ ${Number(m.valor_realizado).toLocaleString('pt-BR',{minimumFractionDigits:2})}</span>
          <span>Meta: R$ ${Number(m.valor_meta).toLocaleString('pt-BR',{minimumFractionDigits:2})}</span>
        </div>
      </div>`;
    }).join('');

    const resumoHtml = data.length > 1 ? `<div style="margin-top:.5rem;padding-top:.75rem;border-top:1px solid var(--border)">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.35rem">
        <span style="font-size:.72rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.05em">Total da equipe</span>
        <span style="font-weight:700;color:var(--${clsGeral})">${pctGeral}%</span>
      </div>
      <div class="progress" style="margin-bottom:.3rem">
        <div class="progress-bar ${clsGeral}" style="width:${Math.min(pctGeral,100)}%"></div>
      </div>
      <div style="display:flex;justify-content:space-between;font-size:.75rem;color:var(--text-muted)">
        <span>R$ ${totalRealizado.toLocaleString('pt-BR',{minimumFractionDigits:2})}</span>
        <span>Meta: R$ ${totalMeta.toLocaleString('pt-BR',{minimumFractionDigits:2})}</span>
      </div>
    </div>` : '';

    body.innerHTML = linhasHtml + resumoHtml;
  }

  // ===== ANIVERSÁRIOS =====
  async function loadAniversarios() {
    const mes = getMes();
    document.getElementById('aniv-periodo')!.textContent = MESES[mes];

    const { data, error } = await supabase
      .from('funcionarios')
      .select('nome, cargo, data_nascimento')
      .eq('ativo', true)
      .not('data_nascimento', 'is', null);

    const body = document.getElementById('aniv-body')!;

    // Sem isto, uma falha na consulta apareceria como "nenhum
    // aniversário" e esconderia o problema real.
    if (error) {
      body.innerHTML = `<div class="alert alert-danger" style="margin:0">Erro ao carregar aniversários: ${escapeHtml(error.message)}</div>`;
      return;
    }

    const comData = data ?? [];
    const aniv = comData
      .filter((f: any) => f.data_nascimento && parseInt(f.data_nascimento.split('-')[1]) === mes)
      .sort((a: any, b: any) => parseInt(a.data_nascimento.split('-')[2]) - parseInt(b.data_nascimento.split('-')[2]));

    const hoje = new Date();
    if (aniv.length === 0) {
      // Distingue "ninguém faz aniversário neste mês" de "ninguém tem
      // data de nascimento cadastrada" — problemas bem diferentes.
      body.innerHTML = comData.length === 0
        ? `<div class="empty"><div class="empty-icon">🎂</div>
             Nenhum funcionário ativo tem data de nascimento cadastrada.<br>
             <span style="font-size:.85em">Preencha em Admin → Funcionários.</span>
           </div>`
        : `<div class="empty"><div class="empty-icon">🎂</div>Nenhum aniversário em ${MESES[mes]}</div>`;
      return;
    }
    body.innerHTML = aniv.map((f: any) => {
      const day = parseInt(f.data_nascimento.split('-')[2]);
      const anoNasc = parseInt(f.data_nascimento.split('-')[0]);
      const birth = new Date(hoje.getFullYear(), mes - 1, day);
      const isToday = birth.getDate() === hoje.getDate() && birth.getMonth() === hoje.getMonth();
      const isPast = birth < hoje && !isToday;
      const idadeAniversario = hoje.getFullYear() - anoNasc;
      const opacityStyle = isPast ? 'opacity:.6;' : '';
      return `<div style="display:flex;align-items:center;gap:.75rem;padding:.6rem 0;border-bottom:1px solid var(--border);${opacityStyle}">
        <div style="font-size:1.5rem;min-width:2rem;text-align:center">${isToday ? '🎉' : '🎂'}</div>
        <div style="flex:1">
          <div style="font-weight:600${isToday ? ';color:var(--success)' : ''}">${escapeHtml(f.nome)}${isToday ? ' — Hoje! 🎉' : ''}</div>
          <div style="font-size:.75rem;color:var(--text-muted)">${escapeHtml(f.cargo ?? '')} · Dia ${day} · ${idadeAniversario} anos</div>
        </div>
        ${isToday ? '<span class="badge badge-success">Hoje</span>' : !isPast ? '<span class="badge badge-info">Em breve</span>' : ''}
      </div>`;
    }).join('');
  }

  // ===== FOLGAS =====
  let folgaFilter = '';
  async function loadFolgas() {
    const mes = getMes(); const ano = getAno();
    const { inicio, fim } = intervaloDoMes(mes, ano);
    let query = supabase
      .from('folgas')
      .select('*, funcionarios(nome)')
      .lte('data_inicio', fim)
      .gte('data_fim', inicio)
      .order('data_inicio');
    if (folgaFilter) query = query.eq('tipo', folgaFilter);
    const { data, error } = await query;

    const body = document.getElementById('folgas-body')!;
    if (error) {
      body.innerHTML = `<div class="alert alert-danger" style="margin:0">Erro ao carregar folgas: ${escapeHtml(error.message)}</div>`;
      return;
    }
    if (!data || data.length === 0) {
      body.innerHTML = `<div class="empty"><div class="empty-icon">📅</div>Nenhuma folga ou férias em ${MESES[mes]}</div>`;
      return;
    }

    body.innerHTML = montarCalendario(data, mes, ano) + montarListaFolgas(data);
  }

  /**
   * Distribui cada folga pelos dias que ela ocupa DENTRO do mês exibido.
   * Um período pode começar no mês anterior ou terminar no seguinte, então
   * as pontas são recortadas na borda do mês em vez de descartadas.
   */
  function diasOcupados(f: any, mes: number, ano: number, diasNoMes: number) {
    const [ai, mi, di] = f.data_inicio.split('-').map(Number);
    const [af, mf, df] = f.data_fim.split('-').map(Number);
    const comecouAntes = ai < ano || (ai === ano && mi < mes);
    const terminaDepois = af > ano || (af === ano && mf > mes);
    const primeiro = comecouAntes ? 1 : di;
    const ultimo = terminaDepois ? diasNoMes : df;
    const dias: number[] = [];
    for (let d = primeiro; d <= ultimo; d++) dias.push(d);
    return dias;
  }

  function nomeResumido(nome: string) {
    const partes = nome.trim().split(/\s+/);
    if (partes.length <= 1) return partes[0] ?? nome;
    return `${partes[0]} ${partes[partes.length - 1]}`;
  }

  function montarCalendario(folgas: any[], mes: number, ano: number) {
    const diasNoMes = new Date(ano, mes, 0).getDate();
    const vaziosNoInicio = new Date(ano, mes - 1, 1).getDay(); // 0 = domingo

    // dia -> lista de quem está de folga/férias naquele dia
    const porDia = new Map<number, { nome: string; tipo: string; observacao?: string }[]>();
    for (const f of folgas) {
      const nome = f.funcionarios?.nome ?? '—';
      for (const d of diasOcupados(f, mes, ano, diasNoMes)) {
        if (!porDia.has(d)) porDia.set(d, []);
        porDia.get(d)!.push({ nome, tipo: f.tipo, observacao: f.observacao ?? undefined });
      }
    }

    const hoje = new Date();
    const ehMesAtual = hoje.getMonth() + 1 === mes && hoje.getFullYear() === ano;
    const diaHoje = hoje.getDate();

    const cabecalho = ['D', 'S', 'T', 'Q', 'Q', 'S', 'S']
      .map((d, i) => `<div class="cal-dow" aria-hidden="true">${d}</div>`).join('');

    const vazias = Array.from({ length: vaziosNoInicio }, () => '<div class="cal-dia vazia"></div>').join('');

    const celulas = Array.from({ length: diasNoMes }, (_, i) => {
      const dia = i + 1;
      const gente = porDia.get(dia) ?? [];
      const temFerias = gente.some(g => g.tipo === 'ferias');
      const temFolga = gente.some(g => g.tipo === 'folga');
      const temHorario = gente.some(g => g.tipo === 'horario');
      const classes = ['cal-dia'];
      if (gente.length) classes.push('ocupado');
      if (temFerias) classes.push('tem-ferias');
      if (temFolga) classes.push('tem-folga');
      if (temHorario) classes.push('tem-horario');
      if (ehMesAtual && dia === diaHoje) classes.push('hoje');

      // Até 3 marcadores por dia; acima disso o "+N" evita estourar a célula
      const visiveis = gente.slice(0, 3);
      const extras = gente.length - visiveis.length;

      const pontos = visiveis
        .map(g => `<span class="cal-ponto ${g.tipo}"></span>`).join('') +
        (extras > 0 ? `<span class="cal-mais">+${extras}</span>` : '');

      // Nome + sobrenome; para horário inclui a observação no chip.
      const nomes = visiveis.map(g => {
        const nomeLabel = escapeHtml(nomeResumido(g.nome));
        const obs = g.tipo === 'horario' && g.observacao ? ` · ${escapeHtml(g.observacao)}` : '';
        return `<span class="cal-nome ${g.tipo}" title="${escapeHtml(g.nome)}${obs ? ' — ' + escapeHtml(g.observacao!) : ''}">${nomeLabel}${obs}</span>`;
      }).join('') + (extras > 0 ? `<span class="cal-nome mais">+${extras}</span>` : '');

      const titulo = gente.length
        ? `${dia}: ${gente.map(g => {
            const t = g.tipo === 'ferias' ? 'férias' : g.tipo === 'horario' ? `horário${g.observacao ? ': ' + g.observacao : ''}` : 'folga';
            return `${g.nome} (${t})`;
          }).join(', ')}`
        : String(dia);

      // As duas formas são geradas sempre; o CSS escolhe qual mostrar
      // conforme a largura da tela.
      const dataInfo = gente.length
        ? ` data-dia="${dia}" data-info='${JSON.stringify(gente).replace(/'/g, '&#39;')}' role="button" tabindex="0" aria-label="${escapeHtml(titulo)}" style="cursor:pointer"`
        : '';
      return `<div class="${classes.join(' ')}" title="${escapeHtml(titulo)}"${dataInfo}>
        <span class="cal-num">${dia}</span>
        <span class="cal-pontos">${pontos}</span>
        <span class="cal-nomes">${nomes}</span>
      </div>`;
    }).join('');

    // O wrapper é o elemento medido pela container query do CSS: o que
    // decide entre nomes e bolinhas é a largura do card, não a da
    // janela — o card muda de largura conforme a grade da página.
    return `<div class="cal-wrap">
        <div class="cal" role="grid" aria-label="Calendário de folgas e férias">
          ${cabecalho}${vazias}${celulas}
        </div>
        <div class="cal-legenda">
          <span><span class="cal-ponto folga"></span> <strong>Folga</strong></span>
          <span><span class="cal-ponto ferias"></span> <strong>Férias</strong></span>
          <span><span class="cal-ponto horario"></span> <strong>Mudança de Horário</strong></span>
        </div>
      </div>`;
  }

  /** Os nomes não cabem dentro das células no celular, então vão abaixo. */
  function montarListaFolgas(folgas: any[]) {
    return `<ul class="cal-lista">` + folgas.map((f: any) => {
      const ini = new Date(f.data_inicio + 'T00:00:00');
      const fim = new Date(f.data_fim + 'T00:00:00');
      const dias = Math.round((fim.getTime() - ini.getTime()) / 86400000) + 1;
      const { badge, rotulo } = f.tipo === 'ferias'
        ? { badge: 'badge-info', rotulo: '🏖️ Férias' }
        : f.tipo === 'horario'
          ? { badge: 'badge-horario', rotulo: '🕐 Horário' }
          : { badge: 'badge-warning', rotulo: '📋 Folga' };
      const obsTexto = f.tipo === 'horario' && f.observacao
        ? ` · <em>${escapeHtml(f.observacao)}</em>` : '';
      return `<li class="cal-lista-item">
        <span class="cal-ponto ${f.tipo}"></span>
        <span class="cal-lista-nome">${escapeHtml(f.funcionarios?.nome ?? '—')}</span>
        <span class="cal-lista-datas">
          ${formatDate(f.data_inicio)} → ${formatDate(f.data_fim)} · ${dias} dia${dias > 1 ? 's' : ''}${obsTexto}
        </span>
        <span class="badge ${badge}">${rotulo}</span>
      </li>`;
    }).join('') + '</ul>';
  }

  function formatDate(d: string) {
    const [y, m, day] = d.split('-');
    return `${day}/${m}/${y}`;
  }

  document.querySelectorAll('.filter-tipo').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-tipo').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      folgaFilter = (btn as HTMLElement).dataset.tipo ?? '';
      loadFolgas();
    });
  });

  // ===== VENDAS =====
  async function loadVendas() {
    const mes = getMes(); const ano = getAno();
    document.getElementById('vendas-periodo')!.textContent = `${MESES[mes]} ${ano}`;
    const { data } = await supabase
      .from('vendas_funcionario')
      .select('valor, funcionarios(nome)')
      .eq('mes', mes).eq('ano', ano)
      .gt('valor', 0)
      .order('valor', { ascending: false });

    const body = document.getElementById('vendas-body')!;
    if (!data || data.length === 0) {
      body.innerHTML = '<div class="empty"><div class="empty-icon">💰</div>Nenhuma venda lançada</div>';
      return;
    }
    const maxVal = Math.max(...data.map((v: any) => Number(v.valor)));
    const totalVendas = data.reduce((s: number, v: any) => s + Number(v.valor ?? 0), 0);

    const barrasHtml = data.map((v: any, i: number) => {
      const pct = maxVal > 0 ? Math.round((v.valor / maxVal) * 100) : 0;
      const colors = ['var(--accent)','var(--slate-700)','#7c3aed','#dc2626','#d97706'];
      const color = colors[i % colors.length];
      return `<div style="margin-bottom:.75rem">
        <div style="display:flex;justify-content:space-between;margin-bottom:.3rem">
          <span style="font-weight:500">${escapeHtml((v.funcionarios as any)?.nome ?? '—')}</span>
          <span style="font-weight:600">R$ ${Number(v.valor).toLocaleString('pt-BR',{minimumFractionDigits:2})}</span>
        </div>
        <div class="progress">
          <div class="progress-bar" style="width:${pct}%;background:${color}"></div>
        </div>
      </div>`;
    }).join('');

    const totalHtml = data.length > 1 ? `<div style="margin-top:.25rem;padding-top:.65rem;border-top:1px solid var(--border);display:flex;justify-content:space-between;font-size:.85rem">
      <span style="font-weight:600;color:var(--text-muted)">Total</span>
      <span style="font-weight:700">R$ ${totalVendas.toLocaleString('pt-BR',{minimumFractionDigits:2})}</span>
    </div>` : '';

    body.innerHTML = barrasHtml + totalHtml;
  }

  // ===== TOP PRODUTOS =====
  let allProdutos: any[] = [];
  async function loadProdutos() {
    const { data } = await supabase
      .from('produtos_top')
      .select('*')
      .order('quantidade', { ascending: false, nullsFirst: false });
    allProdutos = data ?? [];
    renderProdutos();
