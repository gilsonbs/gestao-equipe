---
import '../styles/global.css';
const base = import.meta.env.BASE_URL;
const MESES = ['','Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
const now = new Date();
const mesAtual = now.getMonth() + 1;
const anoAtual = now.getFullYear();
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard — Gestão de Equipe</title>
  <link rel="icon" href={`${base}favicon.svg`} />
</head>
<body>

<header class="top-bar">
  <div class="top-bar-inner">
    <div class="brand">
      <span class="brand-icon">💊</span>
      <div class="brand-text">
        <div class="brand-title">Gestão de Equipe</div>
        <div class="brand-sub">Painel da equipe</div>
      </div>
    </div>
    <a href={`${base}admin/`} class="btn btn-sm admin-link">⚙️ <span>Admin</span></a>
  </div>
  <div class="top-bar-period">
    <label class="period-label" for="sel-mes">Período</label>
    <div class="period-controls">
      <select id="sel-mes" class="form-control">
        {MESES.slice(1).map((m, i) => (
          <option value={i + 1} selected={i + 1 === mesAtual}>{m}</option>
        ))}
      </select>
      <input type="number" id="sel-ano" class="form-control" value={anoAtual}
        min="2020" max="2100" aria-label="Ano" />
    </div>
  </div>
</header>

<main class="dashboard">

  <!-- Avisos ativos -->
  <section class="section" id="avisos-section" hidden>
    <div id="avisos-list" class="avisos-list"></div>
  </section>

  <!-- Stats Row -->
  <section class="grid-4 section" id="stats-row">
    <div class="stat-card" id="stat-vendas-loja">
      <div class="stat-label">Vendas da Loja</div>
      <div class="stat-value loading-val">—</div>
      <div class="loja-progresso" hidden>
        <div class="progress"><div class="progress-bar" id="loja-barra" style="width:0%"></div></div>
      </div>
      <div class="stat-sub" id="loja-sub">este mês</div>
    </div>
    <div class="stat-card" id="stat-total-metas">
      <div class="stat-label">Funcionários com Meta</div>
      <div class="stat-value loading-val">—</div>
      <div class="stat-sub">lançadas este mês</div>
    </div>
    <div class="stat-card" id="stat-media-metas">
      <div class="stat-label">Atingimento Médio</div>
      <div class="stat-value loading-val">—</div>
      <div class="stat-sub">de metas este mês</div>
    </div>
    <div class="stat-card" id="stat-folgas">
      <div class="stat-label">Folgas/Férias</div>
      <div class="stat-value loading-val">—</div>
      <div class="stat-sub">agendadas este mês</div>
    </div>
  </section>

  <div class="grid-2 section">
    <!-- Metas dos Funcionários -->
    <div class="card">
      <div class="card-header">
        <span class="card-title">🎯 Metas dos Funcionários</span>
        <span id="metas-periodo" style="font-size:.8rem;color:#64748b"></span>
      </div>
      <div class="card-body" id="metas-body">
        <div class="loading"><div class="spinner"></div> Carregando...</div>
      </div>
    </div>

    <!-- Aniversários -->
    <div class="card">
      <div class="card-header">
        <span class="card-title">🎂 Aniversários do Mês</span>
        <span id="aniv-periodo" style="font-size:.8rem;color:var(--text-muted)"></span>
      </div>
      <div class="card-body" id="aniv-body">
        <div class="loading"><div class="spinner"></div> Carregando...</div>
      </div>
    </div>
  </div>

  <div class="grid-2 section">
    <!-- Calendário de Folgas -->
    <div class="card">
      <div class="card-header">
        <span class="card-title">📅 Folgas & Férias</span>
        <div style="display:flex;gap:.5rem">
          <button class="btn btn-ghost btn-sm filter-tipo active" data-tipo="">Todos</button>
          <button class="btn btn-ghost btn-sm filter-tipo" data-tipo="folga">Folgas</button>
          <button class="btn btn-ghost btn-sm filter-tipo" data-tipo="ferias">Férias</button>
        </div>
      </div>
      <div class="card-body" id="folgas-body">
        <div class="loading"><div class="spinner"></div> Carregando...</div>
      </div>
    </div>

    <!-- Vendas por Funcionário -->
    <div class="card">
      <div class="card-header">
        <span class="card-title">💰 Vendas por Funcionário</span>
        <span id="vendas-periodo" style="font-size:.8rem;color:#64748b"></span>
      </div>
      <div class="card-body" id="vendas-body">
        <div class="loading"><div class="spinner"></div> Carregando...</div>
      </div>
    </div>
  </div>

  <!-- Top Produtos -->
  <section class="card section">
    <div class="card-header">
      <span class="card-title">💊 Top Produtos</span>
      <div class="prod-filtros">
        <input class="form-control" id="busca-prod" placeholder="🔍 Nome ou substância..." />
        <select class="form-control" id="prod-mes">
          <option value="">Todos os meses</option>
          {MESES.slice(1).map((m, i) => (
            <option value={i + 1}>{m}</option>
          ))}
        </select>
      </div>
    </div>
    <div class="card-body" id="produtos-body" style="padding:0">
      <div class="loading"><div class="spinner"></div> Carregando...</div>
    </div>
  </section>

  <!-- Histórico de avisos -->
  <section class="card section">
    <details id="hist-details">
      <summary class="hist-summary">
        <span class="card-title">🗂️ Histórico de avisos</span>
        <span class="hist-meta"><span id="hist-count">—</span> <span class="hist-chevron">▾</span></span>
      </summary>
      <div class="card-body" id="historico-body">
        <div class="loading"><div class="spinner"></div> Carregando...</div>
      </div>
    </details>
  </section>

</main>

<script>
  import { supabase } from '../lib/supabase';
  import { intervaloDoMes, formatarData } from '../lib/dates';

  const MESES = ['','Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
  const MESES_SHORT = ['','Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];

  /* Os avisos são escritos por pessoas e vão para innerHTML — escapar
     é o que impede que um "<" no texto quebre ou injete marcação. */
  function escapeHtml(s: string) {
    return String(s).replace(/[&<>"']/g, c =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  }

  const TIPOS_AVISO: Record<string, { classe: string; icone: string; rotulo: string }> = {
    info:    { classe: 'aviso-info',    icone: 'ℹ️', rotulo: 'Informativo' },
    atencao: { classe: 'aviso-atencao', icone: '⚠️', rotulo: 'Atenção' },
    urgente: { classe: 'aviso-urgente', icone: '🚨', rotulo: 'Urgente' },
  };

  const selMes = document.getElementById('sel-mes') as HTMLSelectElement;
  const selAno = document.getElementById('sel-ano') as HTMLInputElement;

  function getMes() { return parseInt(selMes.value); }
  function getAno() { return parseInt(selAno.value); }

  // ===== STATS =====
  async function loadStats() {
    const mes = getMes(); const ano = getAno();
    const { inicio, fim } = intervaloDoMes(mes, ano);
    const [lojaRes, desempenhoRes, folgasRes] = await Promise.all([
      supabase.from('desempenho_loja').select('*').eq('mes', mes).eq('ano', ano).maybeSingle(),
      supabase.from('desempenho_mensal').select('valor_meta, percentual').eq('mes', mes).eq('ano', ano),
      supabase.from('folgas').select('id', { count: 'exact', head: true })
        .gte('data_inicio', inicio).lte('data_inicio', fim),
    ]);

    const totalLoja = Number(lojaRes.data?.valor_realizado ?? 0);
    const metaLoja = Number(lojaRes.data?.valor_meta ?? 0);
    document.getElementById('stat-vendas-loja')!.querySelector('.stat-value')!.textContent =
      `R$ ${totalLoja.toLocaleString('pt-BR', {minimumFractionDigits:2})}`;

    // A barra só aparece quando há meta definida — sem meta, não há
    // progresso a mostrar, e o card volta a ser só o valor do mês.
    const progressoEl = document.querySelector('.loja-progresso') as HTMLElement;
    const subEl = document.getElementById('loja-sub')!;
    if (metaLoja > 0) {
      const pctLoja = Number(lojaRes.data?.percentual ?? 0);
      const barra = document.getElementById('loja-barra') as HTMLElement;
      barra.style.width = `${Math.min(pctLoja, 100)}%`;
      barra.className = 'progress-bar ' + (pctLoja >= 100 ? 'success' : pctLoja >= 70 ? 'warning' : 'danger');
      progressoEl.hidden = false;
      subEl.textContent = `${pctLoja}% da meta de R$ ${metaLoja.toLocaleString('pt-BR', {minimumFractionDigits:2})}`;
    } else {
      progressoEl.hidden = true;
      subEl.textContent = 'este mês';
    }

    const linhas = desempenhoRes.data ?? [];
    const comMeta = linhas.filter((d: any) => Number(d.valor_meta) > 0);
    document.getElementById('stat-total-metas')!.querySelector('.stat-value')!.textContent = String(comMeta.length);

    // Só entra na média quem tem meta definida — quem vendeu sem meta
    // tem percentual NULL e não deve puxar o indicador para baixo.
    const comPercentual = linhas.filter((d: any) => d.percentual !== null);
    const media = comPercentual.length > 0
      ? Math.round(comPercentual.reduce((s: number, d: any) => s + Number(d.percentual), 0) / comPercentual.length)
      : 0;
    const mediaEl = document.getElementById('stat-media-metas')!.querySelector('.stat-value') as HTMLElement;
    const temMedia = comPercentual.length > 0;
    mediaEl.textContent = temMedia ? `${media}%` : '—';
    // Sem nenhuma meta lançada não há desempenho ruim a sinalizar — pintar
    // o traço de vermelho faria parecer alerta onde só falta informação.
    mediaEl.style.color = !temMedia
      ? 'var(--text-subtle)'
      : media >= 100 ? 'var(--success)' : media >= 70 ? 'var(--warning)' : 'var(--danger)';

    document.getElementById('stat-folgas')!.querySelector('.stat-value')!.textContent =
      String(folgasRes.count ?? 0);
  }

  // ===== METAS =====
  async function loadMetas() {
    const mes = getMes(); const ano = getAno();
    document.getElementById('metas-periodo')!.textContent = `${MESES[mes]} ${ano}`;
    const { data } = await supabase
      .from('desempenho_mensal')
      .select('*')
      .eq('mes', mes).eq('ano', ano)
      .gt('valor_meta', 0)
      .order('valor_meta', { ascending: false });

    const body = document.getElementById('metas-body')!;
    if (!data || data.length === 0) {
      body.innerHTML = '<div class="empty"><div class="empty-icon">🎯</div>Nenhuma meta lançada para este período</div>';
      return;
    }
    body.innerHTML = data.map((m: any) => {
      const pctReal = Number(m.percentual ?? 0);
      const pct = Math.min(pctReal, 100);
      const cls = pctReal >= 100 ? 'success' : pctReal >= 70 ? 'warning' : 'danger';
      const color = pctReal >= 100 ? 'var(--success)' : pctReal >= 70 ? 'var(--warning)' : 'var(--danger)';
      return `<div style="margin-bottom:1rem">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.35rem">
          <div>
            <span style="font-weight:600">${m.nome ?? '—'}</span>
            ${m.cargo ? `<span style="font-size:.75rem;color:#64748b;margin-left:.5rem">${m.cargo}</span>` : ''}
          </div>
          <span style="font-weight:700;color:${color}">${pctReal}%</span>
        </div>
        <div class="progress" style="margin-bottom:.3rem">
          <div class="progress-bar ${cls}" style="width:${pct}%"></div>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:.75rem;color:#64748b">
          <span>Realizado: R$ ${Number(m.valor_realizado).toLocaleString('pt-BR',{minimumFractionDigits:2})}</span>
          <span>Meta: R$ ${Number(m.valor_meta).toLocaleString('pt-BR',{minimumFractionDigits:2})}</span>
        </div>
      </div>`;
    }).join('');
  }

  // ===== ANIVERSÁRIOS =====
  async function loadAniversarios() {
    const mes = getMes();
    document.getElementById('aniv-periodo')!.textContent = MESES[mes];

    const { data, error } = await supabase
      .from('funcionarios')
      .select('nome, cargo, data_nascimento')
      .eq('ativo', true)
      .not('data_nascimento', 'is', null);

    const body = document.getElementById('aniv-body')!;

    // Sem isto, uma falha na consulta apareceria como "nenhum
    // aniversário" e esconderia o problema real.
    if (error) {
      body.innerHTML = `<div class="alert alert-danger" style="margin:0">Erro ao carregar aniversários: ${escapeHtml(error.message)}</div>`;
      return;
    }

    const comData = data ?? [];
    const aniv = comData
      .filter((f: any) => f.data_nascimento && parseInt(f.data_nascimento.split('-')[1]) === mes)
      .sort((a: any, b: any) => parseInt(a.data_nascimento.split('-')[2]) - parseInt(b.data_nascimento.split('-')[2]));

    const hoje = new Date();
    if (aniv.length === 0) {
      // Distingue "ninguém faz aniversário neste mês" de "ninguém tem
      // data de nascimento cadastrada" — problemas bem diferentes.
      body.innerHTML = comData.length === 0
        ? `<div class="empty"><div class="empty-icon">🎂</div>
             Nenhum funcionário ativo tem data de nascimento cadastrada.<br>
             <span style="font-size:.85em">Preencha em Admin → Funcionários.</span>
           </div>`
        : `<div class="empty"><div class="empty-icon">🎂</div>Nenhum aniversário em ${MESES[mes]}</div>`;
      return;
    }
    body.innerHTML = aniv.map((f: any) => {
      const day = parseInt(f.data_nascimento.split('-')[2]);
      const birth = new Date(hoje.getFullYear(), mes - 1, day);
      const isToday = birth.getDate() === hoje.getDate() && birth.getMonth() === hoje.getMonth();
      const isPast = birth < hoje && !isToday;
      return `<div style="display:flex;align-items:center;gap:.75rem;padding:.6rem 0;border-bottom:1px solid #e2e8f0">
        <div style="font-size:1.5rem;min-width:2rem;text-align:center">${isToday ? '🎉' : isPast ? '🎂' : '🎂'}</div>
        <div style="flex:1">
          <div style="font-weight:600${isToday ? ';color:var(--success)' : ''}">${f.nome}${isToday ? ' — Hoje! 🎉' : ''}</div>
          <div style="font-size:.75rem;color:#64748b">${f.cargo ?? ''} · Dia ${day}</div>
        </div>
        ${isToday ? '<span class="badge badge-success">Hoje</span>' : ''}
      </div>`;
    }).join('');
  }

  // ===== FOLGAS =====
  let folgaFilter = '';
  async function loadFolgas() {
    const mes = getMes(); const ano = getAno();
    const { inicio, fim } = intervaloDoMes(mes, ano);
    let query = supabase
      .from('folgas')
      .select('*, funcionarios(nome)')
      .lte('data_inicio', fim)
      .gte('data_fim', inicio)
      .order('data_inicio');
    if (folgaFilter) query = query.eq('tipo', folgaFilter);
    const { data, error } = await query;

    const body = document.getElementById('folgas-body')!;
    if (error) {
      body.innerHTML = `<div class="alert alert-danger" style="margin:0">Erro ao carregar folgas: ${escapeHtml(error.message)}</div>`;
      return;
    }
    if (!data || data.length === 0) {
      body.innerHTML = `<div class="empty"><div class="empty-icon">📅</div>Nenhuma folga ou férias em ${MESES[mes]}</div>`;
      return;
    }

    body.innerHTML = montarCalendario(data, mes, ano) + montarListaFolgas(data);
  }

  /**
   * Distribui cada folga pelos dias que ela ocupa DENTRO do mês exibido.
   * Um período pode começar no mês anterior ou terminar no seguinte, então
   * as pontas são recortadas na borda do mês em vez de descartadas.
   */
  function diasOcupados(f: any, mes: number, ano: number, diasNoMes: number) {
    const [ai, mi, di] = f.data_inicio.split('-').map(Number);
    const [af, mf, df] = f.data_fim.split('-').map(Number);
    const comecouAntes = ai < ano || (ai === ano && mi < mes);
    const terminaDepois = af > ano || (af === ano && mf > mes);
    const primeiro = comecouAntes ? 1 : di;
    const ultimo = terminaDepois ? diasNoMes : df;
    const dias: number[] = [];
    for (let d = primeiro; d <= ultimo; d++) dias.push(d);
    return dias;
  }

  function primeiroNome(nome: string) {
    return nome.trim().split(/\s+/)[0];
  }

  function montarCalendario(folgas: any[], mes: number, ano: number) {
    const diasNoMes = new Date(ano, mes, 0).getDate();
    const vaziosNoInicio = new Date(ano, mes - 1, 1).getDay(); // 0 = domingo

    // dia -> lista de quem está de folga/férias naquele dia
    const porDia = new Map<number, { nome: string; tipo: string }[]>();
    for (const f of folgas) {
      const nome = f.funcionarios?.nome ?? '—';
      for (const d of diasOcupados(f, mes, ano, diasNoMes)) {
        if (!porDia.has(d)) porDia.set(d, []);
        porDia.get(d)!.push({ nome, tipo: f.tipo });
      }
    }

    const hoje = new Date();
    const ehMesAtual = hoje.getMonth() + 1 === mes && hoje.getFullYear() === ano;
    const diaHoje = hoje.getDate();

    const cabecalho = ['D', 'S', 'T', 'Q', 'Q', 'S', 'S']
      .map((d, i) => `<div class="cal-dow" aria-hidden="true">${d}</div>`).join('');

    const vazias = Array.from({ length: vaziosNoInicio }, () => '<div class="cal-dia vazia"></div>').join('');

    const celulas = Array.from({ length: diasNoMes }, (_, i) => {
      const dia = i + 1;
      const gente = porDia.get(dia) ?? [];
      const temFerias = gente.some(g => g.tipo === 'ferias');
      const temFolga = gente.some(g => g.tipo === 'folga');
      const classes = ['cal-dia'];
      if (gente.length) classes.push('ocupado');
      if (temFerias) classes.push('tem-ferias');
      if (temFolga) classes.push('tem-folga');
      if (ehMesAtual && dia === diaHoje) classes.push('hoje');

      // Até 3 marcadores por dia; acima disso o "+N" evita estourar a célula
      const visiveis = gente.slice(0, 3);
      const extras = gente.length - visiveis.length;

      const pontos = visiveis
        .map(g => `<span class="cal-ponto ${g.tipo}"></span>`).join('') +
        (extras > 0 ? `<span class="cal-mais">+${extras}</span>` : '');

      // Só o primeiro nome: é o que cabe na célula e basta para
      // identificar alguém numa equipe deste tamanho. O nome completo
      // fica no title e na lista abaixo da grade.
      const nomes = visiveis.map(g =>
        `<span class="cal-nome ${g.tipo}" title="${escapeHtml(g.nome)}">${escapeHtml(primeiroNome(g.nome))}</span>`
      ).join('') + (extras > 0 ? `<span class="cal-nome mais">+${extras}</span>` : '');

      const titulo = gente.length
        ? `${dia}: ${gente.map(g => `${g.nome} (${g.tipo === 'ferias' ? 'férias' : 'folga'})`).join(', ')}`
        : String(dia);

      // As duas formas são geradas sempre; o CSS escolhe qual mostrar
      // conforme a largura da tela.
      return `<div class="${classes.join(' ')}" title="${escapeHtml(titulo)}">
        <span class="cal-num">${dia}</span>
        <span class="cal-pontos">${pontos}</span>
        <span class="cal-nomes">${nomes}</span>
      </div>`;
    }).join('');

    // O wrapper é o elemento medido pela container query do CSS: o que
    // decide entre nomes e bolinhas é a largura do card, não a da
    // janela — o card muda de largura conforme a grade da página.
    return `<div class="cal-wrap">
        <div class="cal" role="grid" aria-label="Calendário de folgas e férias">
          ${cabecalho}${vazias}${celulas}
        </div>
        <div class="cal-legenda">
          <span><span class="cal-ponto folga"></span> Folga</span>
          <span><span class="cal-ponto ferias"></span> Férias</span>
        </div>
      </div>`;
  }

  /** Os nomes não cabem dentro das células no celular, então vão abaixo. */
  function montarListaFolgas(folgas: any[]) {
    return `<ul class="cal-lista">` + folgas.map((f: any) => {
      const ini = new Date(f.data_inicio + 'T00:00:00');
      const fim = new Date(f.data_fim + 'T00:00:00');
      const dias = Math.round((fim.getTime() - ini.getTime()) / 86400000) + 1;
      const ehFerias = f.tipo === 'ferias';
      return `<li class="cal-lista-item">
        <span class="cal-ponto ${f.tipo}"></span>
        <span class="cal-lista-nome">${escapeHtml(f.funcionarios?.nome ?? '—')}</span>
        <span class="cal-lista-datas">
          ${formatDate(f.data_inicio)} → ${formatDate(f.data_fim)} · ${dias} dia${dias > 1 ? 's' : ''}
        </span>
        <span class="badge ${ehFerias ? 'badge-info' : 'badge-warning'}">${ehFerias ? 'Férias' : 'Folga'}</span>
      </li>`;
    }).join('') + '</ul>';
  }

  function formatDate(d: string) {
    const [y, m, day] = d.split('-');
    return `${day}/${m}/${y}`;
  }

  document.querySelectorAll('.filter-tipo').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-tipo').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      folgaFilter = (btn as HTMLElement).dataset.tipo ?? '';
      loadFolgas();
    });
  });

  // ===== VENDAS =====
  async function loadVendas() {
    const mes = getMes(); const ano = getAno();
    document.getElementById('vendas-periodo')!.textContent = `${MESES[mes]} ${ano}`;
    const { data } = await supabase
      .from('vendas_funcionario')
      .select('valor, funcionarios(nome)')
      .eq('mes', mes).eq('ano', ano)
      .gt('valor', 0)
      .order('valor', { ascending: false });

    const body = document.getElementById('vendas-body')!;
    if (!data || data.length === 0) {
      body.innerHTML = '<div class="empty"><div class="empty-icon">💰</div>Nenhuma venda lançada</div>';
      return;
    }
    const maxVal = Math.max(...data.map((v: any) => Number(v.valor)));
    body.innerHTML = data.map((v: any, i: number) => {
      const pct = maxVal > 0 ? Math.round((v.valor / maxVal) * 100) : 0;
      const colors = ['var(--accent)','var(--slate-700)','#7c3aed','#dc2626','#d97706'];
      const color = colors[i % colors.length];
      return `<div style="margin-bottom:.75rem">
        <div style="display:flex;justify-content:space-between;margin-bottom:.3rem">
          <span style="font-weight:500">${(v.funcionarios as any)?.nome ?? '—'}</span>
          <span style="font-weight:600">R$ ${Number(v.valor).toLocaleString('pt-BR',{minimumFractionDigits:2})}</span>
        </div>
        <div class="progress">
          <div class="progress-bar" style="width:${pct}%;background:${color}"></div>
        </div>
      </div>`;
    }).join('');
  }

  // ===== TOP PRODUTOS =====
  let allProdutos: any[] = [];
  async function loadProdutos() {
    const { data } = await supabase
      .from('produtos_top')
      .select('*')
      .order('quantidade', { ascending: false, nullsFirst: false });
    allProdutos = data ?? [];
    renderProdutos();
  }

  function renderProdutos() {
    const q = (document.getElementById('busca-prod') as HTMLInputElement).value.toLowerCase().trim();
    const mesFilter = (document.getElementById('prod-mes') as HTMLSelectElement).value;
    let filtered = allProdutos;
    if (q) filtered = filtered.filter(p => p.nome?.toLowerCase().includes(q) || p.substancia?.toLowerCase().includes(q));
    if (mesFilter) filtered = filtered.filter(p => String(p.mes) === mesFilter);

    const body = document.getElementById('produtos-body')!;
    if (filtered.length === 0) {
      body.innerHTML = '<div class="empty"><div class="empty-icon">💊</div>Nenhum produto encontrado</div>';
      return;
    }

    body.innerHTML = `<div class="table-wrap"><table class="table-cards">
      <thead><tr><th>#</th><th>Nome</th><th>Substância</th><th>Categoria</th><th>Quantidade</th><th>Período</th></tr></thead>
      <tbody>
        ${filtered.slice(0, 50).map((p, i) => `
          <tr>
            <td data-label="Posição"><strong>#${i+1}</strong></td>
            <td data-label="Nome"><strong>${p.nome}</strong></td>
            <td data-label="Substância">${p.substancia ?? '—'}</td>
            <td data-label="Categoria">${p.categoria ? `<span class="badge badge-info">${p.categoria}</span>` : '—'}</td>
            <td data-label="Quantidade">${p.quantidade ?? '—'}</td>
            <td data-label="Período">${p.mes ? `${MESES_SHORT[p.mes]}/${p.ano}` : '—'}</td>
          </tr>
        `).join('')}
      </tbody>
    </table></div>`;
  }

  // ===== AVISOS =====
  async function loadAvisos() {
    const { data, error } = await supabase
      .from('avisos_com_status')
      .select('*')
      .order('fixado', { ascending: false })
      .order('created_at', { ascending: false });

    const section = document.getElementById('avisos-section')!;
    const lista = document.getElementById('avisos-list')!;
    const histBody = document.getElementById('historico-body')!;
    const histCount = document.getElementById('hist-count')!;

    if (error) {
      section.hidden = false;
      lista.innerHTML = `<div class="alert alert-danger">Não foi possível carregar os avisos: ${escapeHtml(error.message)}</div>`;
      histBody.innerHTML = '';
      histCount.textContent = '';
      return;
    }

    const todos = data ?? [];
    const ativos = todos.filter((a: any) => a.ativo);
    const expirados = todos.filter((a: any) => !a.ativo);

    // Sem avisos ativos a seção some por completo, em vez de ocupar
    // espaço no alto da tela com um card vazio.
    section.hidden = ativos.length === 0;
    lista.innerHTML = ativos.map((a: any) => {
      const t = TIPOS_AVISO[a.tipo] ?? TIPOS_AVISO.info;
      return `<article class="aviso ${t.classe}">
        <div class="aviso-icone" aria-hidden="true">${t.icone}</div>
        <div class="aviso-corpo">
          <div class="aviso-topo">
            <h3 class="aviso-titulo">${a.fixado ? '<span class="aviso-pin" title="Fixado">📌</span>' : ''}${escapeHtml(a.titulo)}</h3>
            <span class="aviso-tipo">${t.rotulo}</span>
          </div>
          <p class="aviso-msg">${escapeHtml(a.mensagem)}</p>
          <div class="aviso-rodape">
            <span>${formatarData(String(a.created_at).slice(0, 10))}</span>
            ${a.data_expiracao ? `<span>· vale até ${formatarData(a.data_expiracao)}</span>` : ''}
          </div>
        </div>
      </article>`;
    }).join('');

    histCount.textContent = expirados.length === 0
      ? 'nenhum'
      : `${expirados.length} aviso${expirados.length > 1 ? 's' : ''}`;

    histBody.innerHTML = expirados.length === 0
      ? '<div class="empty"><div class="empty-icon">🗂️</div>Nenhum aviso arquivado ainda</div>'
      : `<ol class="hist-lista">` + expirados.map((a: any) => {
          const t = TIPOS_AVISO[a.tipo] ?? TIPOS_AVISO.info;
          return `<li class="hist-item">
            <div class="hist-item-topo">
              <span class="hist-item-titulo">${escapeHtml(a.titulo)}</span>
              <span class="badge badge-neutral">${t.rotulo}</span>
            </div>
            <p class="hist-item-msg">${escapeHtml(a.mensagem)}</p>
            <div class="hist-item-data">
              Publicado em ${formatarData(String(a.created_at).slice(0, 10))}
              ${a.data_expiracao ? ` · encerrado em ${formatarData(a.data_expiracao)}` : ''}
            </div>
          </li>`;
        }).join('') + '</ol>';
  }

  let searchTimer: ReturnType<typeof setTimeout>;
  document.getElementById('busca-prod')?.addEventListener('input', () => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(renderProdutos, 200);
  });
  document.getElementById('prod-mes')?.addEventListener('change', renderProdutos);

  // ===== LOAD ALL =====
  function loadAll() {
    loadAvisos(); loadStats(); loadMetas(); loadAniversarios(); loadFolgas(); loadVendas(); loadProdutos();
  }

  // Aniversários dependem só do mês, mas precisam recarregar junto:
  // sem isso o card ficava preso no mês em que a página abriu.
  selMes.addEventListener('change', () => {
    loadStats(); loadMetas(); loadFolgas(); loadVendas(); loadAniversarios();
  });
  selAno.addEventListener('change', () => { loadStats(); loadMetas(); loadFolgas(); loadVendas(); });

  loadAll();
</script>

<style>
  /* ---------- Barra superior ---------- */
  .top-bar {
    background: var(--slate-900);
    color: #fff;
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .top-bar-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: var(--sp-3) var(--sp-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
  }
  .brand { display: flex; align-items: center; gap: var(--sp-3); min-width: 0; }
  .brand-icon {
    font-size: 1.15rem;
    width: 2.25rem; height: 2.25rem;
    display: grid; place-items: center;
    background: var(--accent);
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }
  .brand-text { min-width: 0; }
  .brand-title {
    font-weight: 650;
    font-size: .95rem;
    letter-spacing: -.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .brand-sub { font-size: .75rem; opacity: .55; }

  .admin-link {
    background: rgba(255,255,255,.1);
    color: #fff;
    border: 1px solid rgba(255,255,255,.15);
    flex-shrink: 0;
  }
  .admin-link:hover { background: rgba(255,255,255,.18); color: #fff; }

  /* O seletor de período ganha faixa própria: no celular ele não cabe
     na mesma linha da marca sem espremer os dois. */
  .top-bar-period {
    border-top: 1px solid rgba(255,255,255,.08);
    background: rgba(0,0,0,.15);
  }
  .top-bar-period {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    max-width: 1180px;
    margin: 0 auto;
    padding: var(--sp-2) var(--sp-4);
  }
  .period-label {
    font-size: .7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .06em;
    opacity: .55;
    flex-shrink: 0;
  }
  .period-controls { display: flex; gap: var(--sp-2); flex: 1; min-width: 0; }
  .period-controls .form-control {
    min-height: 2.25rem;
    background: rgba(255,255,255,.1);
    border-color: rgba(255,255,255,.18);
    color: #fff;
    font-size: .875rem;
  }
  .period-controls .form-control:focus {
    border-color: rgba(255,255,255,.5);
    box-shadow: none;
  }
  .period-controls select { flex: 1; min-width: 0; }
  .period-controls input { width: 5.5rem; flex-shrink: 0; }
  .period-controls option { background: var(--slate-800); color: #fff; }

  .dashboard { max-width: 1180px; margin: 0 auto; padding: var(--sp-5) var(--sp-4); }
  .section { margin-bottom: var(--sp-5); }

  .filter-tipo.active { background: var(--accent); color: #fff; border-color: var(--accent); }

  /* ---------- Filtros de produtos ---------- */
  .prod-filtros { display: flex; gap: var(--sp-2); flex-wrap: wrap; }
  .prod-filtros #busca-prod { width: 15rem; }
  .prod-filtros #prod-mes { width: auto; }

  @media (max-width: 640px) {
    .brand-sub { display: none; }
    .admin-link span { display: none; }
    .prod-filtros { width: 100%; }
    .prod-filtros #busca-prod,
    .prod-filtros #prod-mes { width: 100%; }
    .aviso { padding: var(--sp-3); }
  }
</style>
</body>
</html>

