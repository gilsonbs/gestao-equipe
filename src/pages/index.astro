  .dashboard { max-width: 1180px; margin: 0 auto; padding: var(--sp-5) var(--sp-4); }
  .section { margin-bottom: var(--sp-5); }

  .filter-tipo.active { background: var(--accent); color: #fff; border-color: var(--accent); }

  /* ---------- Filtros de produtos ---------- */
  .prod-filtros { display: flex; gap: var(--sp-2); flex-wrap: wrap; }
  .prod-filtros #busca-prod { width: 15rem; }
  .prod-filtros #prod-mes { width: auto; }

  /* ---------- Botão PDF ---------- */
  .export-btn {
    background: rgba(255,255,255,.1);
    color: #fff;
    border: 1px solid rgba(255,255,255,.15);
    flex-shrink: 0;
  }
  .export-btn:hover { background: rgba(255,255,255,.18); color: #fff; }

  /* ---------- Cabeçalho de impressão ---------- */
  .print-header { display: none; }

  /* ---------- Entregas ---------- */
  .entregas-wrap { display: flex; gap: var(--sp-5); align-items: center; }
  .entregas-stat { min-width: 9rem; flex-shrink: 0; }
  .entregas-num { font-size: 2.25rem; font-weight: 700; line-height: 1.1; letter-spacing: -.02em; color: var(--accent); }
  .entregas-label { font-size: .8rem; color: var(--text-muted); margin-top: 3px; }
  .entregas-delta { font-size: .8rem; font-weight: 600; margin-top: 6px; }
  .entregas-chart { flex: 1; min-width: 0; }

  @media (max-width: 640px) {
    .brand-sub { display: none; }
    .admin-link span { display: none; }
    .export-btn span { display: none; }
    .prod-filtros { width: 100%; }
    .prod-filtros #busca-prod,
    .prod-filtros #prod-mes { width: 100%; }
    .aviso { padding: var(--sp-3); }
    .entregas-wrap { flex-direction: column; }
    .entregas-stat { text-align: center; }
  }

  /* ========== MODAL DETALHE DO DIA ========== */
  #modal-dia { display:none; position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,.75); padding:1rem; align-items:flex-end; justify-content:center; }
  #modal-dia.aberto { display:flex; }
  @media (min-width:480px) {
    #modal-dia { align-items:center; }
  }
  #modal-dia-inner {
    background:#1e293b; color:#f1f5f9; border-radius:1rem; width:100%; max-width:420px;
    box-shadow:0 20px 60px rgba(0,0,0,.5); overflow:hidden;
    animation: slideUp .2s ease;
  }
  @keyframes slideUp { from { transform:translateY(40px); opacity:0; } to { transform:none; opacity:1; } }
  #modal-dia-header {
    display:flex; align-items:center; justify-content:space-between;
    padding:.9rem 1.1rem .75rem; border-bottom:1px solid rgba(255,255,255,.12);
  }
  #modal-dia-titulo { font-weight:700; font-size:1rem; color:#f1f5f9; }
  #modal-dia-fechar {
    background:none; border:none; cursor:pointer; color:#94a3b8;
    font-size:1.25rem; line-height:1; padding:.25rem; border-radius:.375rem;
  }
  #modal-dia-fechar:hover { background:rgba(255,255,255,.1); color:#f1f5f9; }
  #modal-dia-body { padding:.85rem 1.1rem 1.1rem; display:flex; flex-direction:column; gap:.55rem; }
  .modal-item { display:flex; align-items:flex-start; gap:.6rem; padding:.55rem .7rem; border-radius:.6rem; background:rgba(255,255,255,.07); }
  .modal-item-nome { font-weight:600; font-size:.92rem; color:#f1f5f9; }
  .modal-item-obs { font-size:.82rem; color:#94a3b8; margin-top:.1rem; }
  .modal-item-badge { font-size:.72rem; padding:.2rem .5rem; border-radius:999px; white-space:nowrap; margin-left:auto; flex-shrink:0; }
  .modal-item-badge.folga { background:#fef9c3; color:#854d0e; border:1px solid #fde68a; }
  .modal-item-badge.ferias { background:#eff6ff; color:#1d4ed8; border:1px solid #bfdbfe; }
  .modal-item-badge.horario { background:#fff7ed; color:#c2410c; border:1px solid #fed7aa; }

  /* ========== REUNIÕES ========== */
  .reuniao-card {
    padding: var(--sp-4);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: var(--sp-3);
  }
  .reuniao-card:last-child { margin-bottom: 0; }
  .reuniao-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-3);
    flex-wrap: wrap;
    margin-bottom: var(--sp-2);
  }
  .reuniao-titulo { font-weight: 700; font-size: .95rem; }
  .reuniao-data { font-size: .8rem; color: var(--text-muted); white-space: nowrap; }
  .reuniao-desc {
    font-size: .875rem;
    line-height: 1.65;
