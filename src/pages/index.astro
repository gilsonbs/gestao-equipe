    .grid-2 { grid-template-columns: 1fr !important; }
    .grid-4 { grid-template-columns: repeat(2, 1fr) !important; }
    .section { margin-bottom: .9rem !important; break-inside: avoid; page-break-inside: avoid; }

    /* Cards mais limpos */
