  /* ========== IMPRESSÃO / EXPORT PDF ========== */
  @media print {
    @page { size: A4 portrait; margin: 1.5cm 1.2cm; }

    /* Força cores na impressão */
    * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }

    /* Esconde o chrome da interface */
    .top-bar { display: none !important; }
    #btn-export-pdf { display: none !important; }
    .filter-tipo, .prod-filtros, #hist-details { display: none !important; }
    .cell-actions { display: none !important; }

    /* Mostra o cabeçalho de impressão */
