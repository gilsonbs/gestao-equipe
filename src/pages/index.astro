  // ===== AVISOS =====
  async function loadAvisos() {
    const { data, error } = await supabase
      .from('avisos_com_status')
      .select('*')
      .order('fixado', { ascending: false })
      .order('created_at', { ascending: false });

    const section = document.getElementById('avisos-section')!;
    const lista = document.getElementById('avisos-list')!;
    const histBody = document.getElementById('historico-body')!;
    const histCount = document.getElementById('hist-count')!;

    if (error) {
      section.hidden = false;
      lista.innerHTML = `<div class="alert alert-danger">Não foi possível carregar os avisos: ${escapeHtml(error.message)}</div>`;
      histBody.innerHTML = '';
      histCount.textContent = '';
      return;
    }

    const todos = data ?? [];
    const ativos = todos.filter((a: any) => a.ativo);
    const expirados = todos.filter((a: any) => !a.ativo);

    // Sem avisos ativos a seção some por completo, em vez de ocupar
    // espaço no alto da tela com um card vazio.
    section.hidden = ativos.length === 0;
    lista.innerHTML = ativos.map((a: any) => {
      const t = TIPOS_AVISO[a.tipo] ?? TIPOS_AVISO.info;
      return `<article class="aviso ${t.classe}">
        <div class="aviso-icone" aria-hidden="true">${t.icone}</div>
        <div class="aviso-corpo">
          <div class="aviso-topo">
            <h3 class="aviso-titulo">${a.fixado ? '<span class="aviso-pin" title="Fixado">📌</span>' : ''}${escapeHtml(a.titulo)}</h3>
            <span class="aviso-tipo">${t.rotulo}</span>
          </div>
          <div class="aviso-msg aviso-md">${renderMd(a.mensagem)}</div>
          <div class="aviso-rodape">
            <span>${formatarData(String(a.created_at).slice(0, 10))}</span>
            ${a.data_expiracao ? `<span>· vale até ${formatarData(a.data_expiracao)}</span>` : ''}
          </div>
        </div>
      </article>`;
    }).join('');

    histCount.textContent = expirados.length === 0
      ? 'nenhum'
      : `${expirados.length} aviso${expirados.length > 1 ? 's' : ''}`;

    histBody.innerHTML = expirados.length === 0
      ? '<div class="empty"><div class="empty-icon">🗂️</div>Nenhum aviso arquivado ainda</div>'
      : `<ol class="hist-lista">` + expirados.map((a: any) => {
          const t = TIPOS_AVISO[a.tipo] ?? TIPOS_AVISO.info;
          return `<li class="hist-item">
            <div class="hist-item-topo">
              <span class="hist-item-titulo">${escapeHtml(a.titulo)}</span>
              <span class="badge badge-neutral">${t.rotulo}</span>
            </div>
            <div class="hist-item-msg aviso-md">${renderMd(a.mensagem)}</div>
            <div class="hist-item-data">
              Publicado em ${formatarData(String(a.created_at).slice(0, 10))}
              ${a.data_expiracao ? ` · encerrado em ${formatarData(a.data_expiracao)}` : ''}
            </div>
          </li>`;
        }).join('') + '</ol>';
  }

  let searchTimer: ReturnType<typeof setTimeout>;
  document.getElementById('busca-prod')?.addEventListener('input', () => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(renderProdutos, 200);
  });
  document.getElementById('prod-mes')?.addEventListener('change', renderProdutos);

  // ===== REUNIÕES =====
  async function loadReunioes() {
    const section = document.getElementById('reunioes-section')!;
    const body = document.getElementById('reunioes-body')!;

    const { data, error } = await supabase
      .from('reunioes')
      .select('*, reunioes_topicos(texto, ordem)')
      .order('data', { ascending: false })
      .limit(10);

    if (error) {
      body.innerHTML = `<div class="alert alert-danger">Erro: ${escapeHtml(error.message)}</div>`;
      section.hidden = false;
      return;
    }
    if (!data || data.length === 0) {
      section.hidden = true;
      return;
    }
    section.hidden = false;

    body.innerHTML = data.map((r: any) => {
      const topicos = (r.reunioes_topicos ?? []).sort((a: any, b: any) => a.ordem - b.ordem);
      const dataFmt = (() => { const [y,m,d] = r.data.split('-'); return `${d}/${m}/${y}`; })();
      const topicosHtml = topicos.length
        ? `<div class="reuniao-topicos-label">Tópicos de Pauta</div><ol class="reuniao-topicos">${topicos.map((t: any) => `<li>${escapeHtml(t.texto)}</li>`).join('')}</ol>`
        : '';
      const descHtml = r.descricao
        ? `<div class="reuniao-desc">${escapeHtml(r.descricao).replace(/\n/g, '<br>')}</div>`
        : '';
      return `<div class="reuniao-card">
        <div class="reuniao-header">
          <span class="reuniao-titulo">${escapeHtml(r.titulo)}</span>
          <span class="reuniao-data">${dataFmt}</span>
        </div>
        ${descHtml}
        ${topicosHtml}
      </div>`;
    }).join('');
  }

  // ===== LOAD ALL =====
  function loadAll() {
    loadAvisos(); loadStats(); loadMetas(); loadAniversarios(); loadFolgas(); loadVendas(); loadProdutos(); loadEscalas(); loadEntregas(); loadReunioes();
  }

  selMes.addEventListener('change', () => {
    loadStats(); loadMetas(); loadFolgas(); loadVendas(); loadAniversarios(); loadEntregas();
  });
  selAno.addEventListener('change', () => { loadStats(); loadMetas(); loadFolgas(); loadVendas(); loadEntregas(); });

  loadAll();

  // ===== EXPORTAR PDF =====
  window.addEventListener('beforeprint', () => {
    const mes = getMes(); const ano = getAno();
    const el = document.getElementById('print-periodo-label');
    if (el) el.textContent = `${MESES[mes]} / ${ano} · emitido em ${new Date().toLocaleDateString('pt-BR')}`;
  });
  document.getElementById('btn-export-pdf')?.addEventListener('click', () => window.print());

  // ===== MODAL DETALHE DO DIA =====
  const modalDia = document.getElementById('modal-dia')!;
  const modalTitulo = document.getElementById('modal-dia-titulo')!;
  const modalBody = document.getElementById('modal-dia-body')!;

  function abrirModalDia(dia: number, gente: { nome: string; tipo: string; observacao?: string }[], mesAtual: number, anoAtual: number) {
    const data = new Date(anoAtual, mesAtual - 1, dia);
    const opts: Intl.DateTimeFormatOptions = { weekday: 'long', day: 'numeric', month: 'long' };
    modalTitulo.textContent = data.toLocaleDateString('pt-BR', opts).replace(/^\w/, c => c.toUpperCase());

    const rotuloMap: Record<string, string> = { folga: 'Folga', ferias: 'Férias', horario: 'Horário' };
    const emojiMap: Record<string, string> = { folga: '📋', ferias: '🏖️', horario: '🕐' };

    modalBody.innerHTML = gente.map(g => {
      const badge = escapeHtml(rotuloMap[g.tipo] ?? g.tipo);
      const obs = g.tipo === 'horario' && g.observacao ? `<div class="modal-item-obs">${escapeHtml(g.observacao)}</div>` : '';
      return `<div class="modal-item">
        <div style="flex:1;min-width:0">
          <div class="modal-item-nome">${escapeHtml(g.nome)}</div>
          ${obs}
        </div>
        <span class="modal-item-badge ${g.tipo}">${emojiMap[g.tipo] ?? ''} ${badge}</span>
      </div>`;
    }).join('');

    modalDia.classList.add('aberto');
    document.body.style.overflow = 'hidden';
  }

  function fecharModalDia() {
    modalDia.classList.remove('aberto');
    document.body.style.overflow = '';
  }

  document.getElementById('modal-dia-fechar')?.addEventListener('click', fecharModalDia);
  modalDia.addEventListener('click', (e) => { if (e.target === modalDia) fecharModalDia(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') fecharModalDia(); });

  // Delegação — funciona para células geradas dinamicamente
  document.getElementById('folgas-body')?.addEventListener('click', (e) => {
    const cel = (e.target as Element).closest('[data-dia]') as HTMLElement | null;
    if (!cel) return;
    const dia = parseInt(cel.dataset.dia!);
    const gente = JSON.parse(cel.dataset.info!);
    abrirModalDia(dia, gente, getMes(), getAno());
  });
  document.getElementById('folgas-body')?.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    const cel = (e.target as Element).closest('[data-dia]') as HTMLElement | null;
    if (!cel) return;
    e.preventDefault();
    const dia = parseInt(cel.dataset.dia!);
    const gente = JSON.parse(cel.dataset.info!);
    abrirModalDia(dia, gente, getMes(), getAno());
  });
</script>

<style>
